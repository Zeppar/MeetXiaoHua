/*
 * 自定义 tabBar 渲染在页面节点树之外，继承不到 app.wxss 里 page{} 的变量，
 * 这里把用到的几个同步定义一份（值与 app.wxss 保持一致）。
 */
.dock-wrap {
  --color-muted: #9a8f84;
  --color-primary: #f08a4b;
  --color-primary-deep: #e8743a;
  --color-title: #2b2622;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 40rpx calc(22rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.dock-wrap.is-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.dock {
  pointer-events: auto;
  height: 128rpx;
  border-radius: 999rpx;
  overflow: visible;
  /* 纸感：不透明暖白 + 细边 + 柔和落影，不再用毛玻璃 */
  background: #fffdf9;
  box-shadow: 0 12rpx 36rpx rgba(90, 60, 30, 0.12);
  border: 2rpx solid rgba(120, 95, 70, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 12rpx;
}

.item {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 28rpx;
  transition: transform 0.15s ease;
}

.item-press {
  transform: scale(0.92);
}

.ico {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
}

.label {
  font-size: 20rpx;
  line-height: 1;
  color: var(--color-muted);
  letter-spacing: 1rpx;
}

.item.on .label {
  color: var(--color-primary-deep);
  font-weight: 700;
}

.plus-wrap {
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus {
  width: 108rpx;
  height: 108rpx;
  margin-top: -10rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #f7a56e 0%, var(--color-primary-deep) 100%);
  box-shadow:
    0 14rpx 28rpx rgba(232, 116, 58, 0.36),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.45);
  border: 7rpx solid rgba(255, 255, 255, 0.92);
  position: relative;
  box-sizing: border-box;
}

.plus {
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-ico {
  width: 50rpx;
  height: 50rpx;
}

.plus-press .plus {
  transform: scale(0.92);
}

.plus {
  transition: transform 0.15s ease;
}
