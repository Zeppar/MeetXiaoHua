<view class="dock-wrap {{hidden ? 'is-hidden' : ''}}">
  <view class="dock">
    <view class="item {{selected === 0 ? 'on' : ''}}" hover-class="item-press" data-path="/pages/home/home" data-index="0" bindtap="onSwitch">
      <image class="ico" src="/assets/icons/{{selected === 0 ? 'home-on' : 'home'}}.svg" />
      <text class="label">首页</text>
    </view>
    <view class="item {{selected === 1 ? 'on' : ''}}" hover-class="item-press" data-path="/pages/album/album" data-index="1" bindtap="onSwitch">
      <image class="ico" src="/assets/icons/{{selected === 1 ? 'album-on' : 'album'}}.svg" />
      <text class="label">图鉴</text>
    </view>

    <view class="plus-wrap" hover-class="plus-press" bindtap="onShoot">
      <view class="plus">
        <image class="plus-ico" src="/assets/icons/camera-white.svg" />
      </view>
    </view>

    <view class="item {{selected === 2 ? 'on' : ''}}" hover-class="item-press" data-path="/pages/room/room" data-index="2" bindtap="onSwitch">
      <image class="ico" src="/assets/icons/{{selected === 2 ? 'room-on' : 'room'}}.svg" />
      <text class="label">小屋</text>
    </view>
    <view class="item {{selected === 3 ? 'on' : ''}}" hover-class="item-press" data-path="/pages/profile/profile" data-index="3" bindtap="onSwitch">
      <image class="ico" src="/assets/icons/{{selected === 3 ? 'profile-on' : 'profile'}}.svg" />
      <text class="label">我的</text>
    </view>
  </view>
</view>
