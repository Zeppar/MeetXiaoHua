<view class="dock-wrap {{hidden ? 'is-hidden' : ''}}">
  <view class="dock">
    <view class="item {{selected === 0 ? 'on' : ''}}" data-path="/pages/home/home" data-index="0" bindtap="onSwitch">
      <view class="ico ico-home"></view>
    </view>
    <view class="item {{selected === 1 ? 'on' : ''}}" data-path="/pages/album/album" data-index="1" bindtap="onSwitch">
      <view class="ico ico-paw">
        <view class="paw-toe toe1"></view>
        <view class="paw-toe toe2"></view>
        <view class="paw-toe toe3"></view>
        <view class="paw-toe toe4"></view>
        <view class="paw-pad"></view>
      </view>
    </view>

    <view class="plus-wrap" bindtap="onShoot">
      <view class="plus">
        <view class="plus-h"></view>
        <view class="plus-v"></view>
      </view>
    </view>

    <view class="item {{selected === 2 ? 'on' : ''}}" data-path="/pages/room/room" data-index="2" bindtap="onSwitch">
      <view class="ico ico-msg"></view>
    </view>
    <view class="item {{selected === 3 ? 'on' : ''}}" data-path="/pages/profile/profile" data-index="3" bindtap="onSwitch">
      <view class="ico ico-me"></view>
    </view>
  </view>
</view>
