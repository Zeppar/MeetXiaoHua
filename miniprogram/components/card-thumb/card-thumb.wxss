.thumb {
  background: rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 12rpx 28rpx rgba(70, 100, 140, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-sizing: border-box;
}

.thumb-img-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 22rpx;
  overflow: hidden;
  background: #e8f1f8;
}

.thumb-img,
.thumb-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  background:
    radial-gradient(circle at 40% 35%, #fff, transparent 40%),
    linear-gradient(160deg, #ffe0d0, #ffb8a8);
}

.badge {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  color: #1f2430;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.thumb-breed {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #1f2430;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.thumb-date,
.thumb-place {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8b95a5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
