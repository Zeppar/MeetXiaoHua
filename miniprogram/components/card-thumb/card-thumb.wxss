.thumb {
  padding: var(--space-2) var(--space-2) var(--space-3);
  box-sizing: border-box;
}

.thumb-img-wrap {
  width: 100%;
  padding-top: 100%;
  position: relative;
  border-radius: var(--radius-md);
  background: var(--color-bg-deep);
  overflow: hidden;
}

.thumb-img {
  position: absolute;
  left: 8%;
  top: 8%;
  width: 84%;
  height: 84%;
  transform: rotate(-2deg);
}

.thumb-ph {
  opacity: 0.8;
  transform: none;
}

.thumb-breed {
  margin: var(--space-2) 0 4rpx;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-title);
}
