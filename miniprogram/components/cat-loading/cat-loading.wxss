.cat-loading.is-full {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(251, 247, 240, 0.86);
}

.cat-loading.is-inline {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.panel {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.paws {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  height: 72rpx;
}

.paw {
  width: 40rpx;
  height: 40rpx;
  opacity: 0;
  animation: step 1.6s ease-in-out infinite;
}

.p1 { transform: rotate(-14deg); }
.p2 { animation-delay: 0.25s; transform: rotate(10deg) translateY(-18rpx); }
.p3 { animation-delay: 0.5s; transform: rotate(-10deg); }
.p4 { animation-delay: 0.75s; transform: rotate(12deg) translateY(-18rpx); }

@keyframes step {
  0%, 100% { opacity: 0; }
  25%, 70% { opacity: 1; }
}

.tip {
  margin-top: var(--space-3);
  font-size: var(--font-sm);
  color: var(--color-text-2);
  letter-spacing: 2rpx;
}

.is-off {
  display: none !important;
}
