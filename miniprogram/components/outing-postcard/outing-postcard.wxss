.outing-postcard {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.postcard-scene {
  position: relative;
  height: 166rpx;
  overflow: hidden;
  border: 2rpx solid #dfd1bd;
  border-radius: 16rpx;
  background: #edf4e9;
}

.postcard-background {
  width: 100%;
  height: 100%;
}

.postcard-cat {
  position: absolute;
  right: 12%;
  bottom: 6rpx;
  width: 140rpx;
  height: 126rpx;
  filter: drop-shadow(0 5rpx 3rpx #46372633);
}

.postcard-story {
  color: #483a2f;
  font-size: 26rpx;
  line-height: 1.65;
}

.postcard-friend {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: #f2eadb;
  color: #483a2f;
  font-size: 24rpx;
}

.friend-photo {
  flex-shrink: 0;
  width: 82rpx;
  height: 68rpx;
  padding: 4rpx;
  border-radius: 5rpx;
  background: #fffaf0;
}

.postcard-source {
  color: #74685b;
  font-size: 21rpx;
}
