<view class="empty anim-rise">
  <image class="empty-illus" src="{{illus}}" mode="aspectFit" />
  <view class="empty-title">{{main}}</view>
  <view wx:if="{{sub}}" class="empty-sub">{{sub}}</view>
  <button wx:if="{{buttonText}}" class="btn-primary empty-btn" bindtap="onTap">{{buttonText}}</button>
</view>
