.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 28rpx 40rpx;
  text-align: center;
}

.empty-art {
  width: 168rpx;
  height: 168rpx;
  border-radius: 48rpx;
  background: linear-gradient(165deg, #f3faf6 0%, #e8f6ee 100%);
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(47, 208, 116, 0.08);
}

.paw {
  position: relative;
  width: 88rpx;
  height: 96rpx;
}

.pad {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 58rpx;
  height: 48rpx;
  transform: translateX(-50%);
  border-radius: 46% 46% 48% 48%;
  background: #9fd9b4;
}

.toe {
  position: absolute;
  width: 26rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #9fd9b4;
}

.t1 {
  left: 0;
  top: 28rpx;
}

.t2 {
  left: 18rpx;
  top: 4rpx;
}

.t3 {
  right: 18rpx;
  top: 4rpx;
}

.t4 {
  right: 0;
  top: 28rpx;
}

.empty-main {
  font-size: 30rpx;
  color: #1f2430;
  font-weight: 800;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b95a5;
  max-width: 480rpx;
  line-height: 1.45;
}

.empty-btn {
  margin-top: 36rpx;
  min-width: 320rpx;
}
