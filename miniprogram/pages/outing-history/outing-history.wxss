.history {
  background: #f5f7fa !important;
}

.head {
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2430;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b95a5;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(70, 100, 140, 0.08);
}

.time {
  font-size: 22rpx;
  color: #8b95a5;
  margin-bottom: 10rpx;
}

.line {
  font-size: 28rpx;
  color: #1f2430;
  line-height: 1.6;
  margin-top: 4rpx;
  font-weight: 600;
}

.muted {
  color: #8b95a5;
  font-weight: 500;
}

.empty-card {
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(70, 100, 140, 0.1);
  padding: 24rpx 12rpx;
}
