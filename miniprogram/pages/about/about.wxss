/* 关于：贴在手帐第一页的街角插画 + 一段小故事 */

.hero {
  margin-top: var(--space-3);
  padding: 14rpx;
  transform: rotate(-1deg);
}

.hero-img {
  display: block;
  width: 100%;
  border-radius: var(--radius-md);
}

.brand {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-5);
}

.brand-logo {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.brand-copy {
  flex: 1;
  min-width: 0;
}

.brand-slogan {
  margin-top: 4rpx;
  font-size: var(--font-md);
  color: var(--color-text-2);
}

.story {
  margin-top: var(--space-4);
  padding: 8rpx var(--space-4);
  font-size: var(--font-md);
  color: var(--color-text);
}

.info {
  margin-top: var(--space-4);
}

.info .list-sub {
  max-width: 60%;
  text-align: right;
}
