.about {
  background: #f5f7fa !important;
}

.hero {
  position: relative;
  height: 360rpx;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(70, 100, 140, 0.14);
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 20%, rgba(20, 30, 45, 0.5));
}

.hero-copy {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  color: #fff;
}

.brand {
  font-size: 44rpx;
  font-weight: 800;
}

.slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 14rpx 32rpx rgba(70, 100, 140, 0.1);
  padding: 8rpx 28rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid rgba(120, 140, 170, 0.08);
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: none;
}

.k {
  color: #8b95a5;
}

.v {
  color: #1f2430;
  font-weight: 600;
}
