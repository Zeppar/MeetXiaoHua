/* 我的：像一本手帐的封面 */

.profile {
  padding-top: var(--space-5);
}

/* —— 封面 —— */
.cover {
  padding: var(--space-5) var(--space-4) var(--space-4) calc(var(--space-4) + 20rpx);
  overflow: visible;
}

/* 左侧书脊：一道橙色细条 + 装订孔 */
.cover-spine {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 18rpx;
  width: 10rpx;
  border-radius: var(--radius-pill);
  background: repeating-linear-gradient(180deg, var(--color-primary-soft) 0 22rpx, transparent 22rpx 34rpx);
}

.cover-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.avatar {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-primary-soft);
  border: 6rpx solid var(--color-surface);
  box-shadow: 0 0 0 3rpx var(--color-title), var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 104rpx;
  height: 104rpx;
}

.avatar-letter {
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: var(--color-surface);
  border: 3rpx solid var(--color-primary-ink);
  color: var(--color-primary-ink);
  font-size: var(--font-sm);
  font-weight: 800;
  line-height: 42rpx;
  text-align: center;
  transform: rotate(8deg);
}

.cover-who {
  flex: 1;
  min-width: 0;
}

.cover-k {
  letter-spacing: 4rpx;
  font-weight: 700;
}

.cover-sub {
  margin-top: 6rpx;
  font-size: var(--font-md);
  color: var(--color-text-2);
}

.cover-line {
  margin: var(--space-4) 0 var(--space-3);
  border-top: 2rpx dashed var(--color-line);
}

/* —— 三枚邮戳 —— */
.stats {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-around;
  padding: var(--space-1) 0;
}

.stat {
  display: flex;
  justify-content: center;
}

.stat-stamp {
  width: 150rpx;
  height: 150rpx;
}

.stat-stamp.tilt-2 { transform: rotate(6deg); }
.stat-stamp.tilt-3 { transform: rotate(-4deg); }

.stat-stamp .stamp-k {
  letter-spacing: 2rpx;
}

.stat-stamp .stamp-v {
  margin-top: 4rpx;
  font-size: var(--font-xl);
}

.stat-sky {
  color: var(--color-sky-ink);
  border-color: rgba(58, 110, 168, 0.7);
  box-shadow: inset 0 0 0 7rpx var(--color-surface), inset 0 0 0 9rpx rgba(58, 110, 168, 0.4);
}

.stat-blush {
  color: var(--color-blush-ink);
  border-color: rgba(184, 80, 106, 0.7);
  box-shadow: inset 0 0 0 7rpx var(--color-surface), inset 0 0 0 9rpx rgba(184, 80, 106, 0.4);
}

.cover-trail {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 180rpx;
  height: 90rpx;
  opacity: 0.55;
}

/* —— 目录 —— */
.ico-orange { background: var(--color-primary-soft); }
.ico-mint { background: var(--color-mint-soft); }
.ico-sky { background: var(--color-sky-soft); }
.ico-blush { background: var(--color-blush-soft); }

/* 意见反馈是原生 button：去掉默认样式，让它看起来和别的行一样 */
.row-btn {
  width: 100%;
  margin: 0;
  background: transparent;
  border-radius: 0;
  line-height: normal;
  font-size: var(--font-md);
  text-align: left;
  color: inherit;
}

/* —— 封底 —— */
.foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--space-5);
}

.foot-cat {
  width: 96rpx;
  height: 112rpx;
  opacity: 0.9;
}

.foot-txt {
  margin-top: var(--space-1);
  font-size: var(--font-sm);
  color: var(--color-muted);
}
