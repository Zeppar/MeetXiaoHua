/* 品种审核 · 猫咪相遇手帐 */

.head {
  margin-bottom: var(--space-5);
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.review-item {
  padding: var(--space-4) var(--space-4) var(--space-3);
}

.review-top {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}

.review-thumb {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  background:
    radial-gradient(rgba(120, 95, 70, 0.1) 2rpx, transparent 2rpx) 0 0 / 20rpx 20rpx,
    var(--color-bg-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-img {
  width: 88%;
  height: 88%;
}

.review-ph {
  width: 70%;
  height: 70%;
  opacity: 0.55;
}

.review-main {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
}

/* A → B */
.review-change {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.from {
  font-size: var(--font-md);
  color: var(--color-text-2);
  text-decoration: line-through;
  text-decoration-color: rgba(154, 143, 132, 0.7);
}

.from-muted {
  color: var(--color-muted);
  text-decoration: none;
}

.to {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-title);
  background: linear-gradient(transparent 58%, rgba(240, 138, 75, 0.28) 58%, rgba(240, 138, 75, 0.28) 92%, transparent 92%);
  padding: 0 4rpx;
}

.arrow {
  display: flex;
  align-items: center;
}

.arrow-line {
  width: 30rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
}

.arrow-head {
  width: 12rpx;
  height: 12rpx;
  margin-left: -10rpx;
  border-top: 4rpx solid var(--color-primary);
  border-right: 4rpx solid var(--color-primary);
  transform: rotate(45deg);
}

.review-time {
  margin-top: 6rpx;
}

.review-seal {
  flex-shrink: 0;
  margin-top: 6rpx;
}

.review-ops {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 2rpx dashed var(--color-line);
  display: flex;
  gap: var(--space-2);
}

.op {
  flex: 1;
}

.empty-card {
  margin-top: var(--space-3);
}
