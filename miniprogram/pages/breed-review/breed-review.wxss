.breed-review {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2430;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b95a5;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(70, 100, 140, 0.08);
}

.time {
  font-size: 22rpx;
  color: #8b95a5;
  margin-bottom: 10rpx;
}

.line {
  font-size: 28rpx;
  color: #1f2430;
  font-weight: 700;
  line-height: 1.5;
}

.muted {
  color: #8b95a5;
  font-weight: 500;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.ops {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.op {
  flex: 1;
  margin: 0;
  font-size: 26rpx !important;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 14rpx 0 !important;
  line-height: 1.3;
}

.op::after { border: none; }

.op.ok {
  background: linear-gradient(180deg, #5aef9a, #2fd074);
  color: #102418;
}

.op.reject {
  background: #f0f3f7;
  color: #5a6575;
}

.empty-card {
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(70, 100, 140, 0.1);
  padding: 24rpx 12rpx;
}
