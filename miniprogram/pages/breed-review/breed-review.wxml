<view class="page breed-review">
  <view class="head">
    <view class="head-title">品种审核</view>
    <view class="head-sub">用户提交的换品种申请，在这里通过或驳回</view>
  </view>

  <view wx:if="{{ready && !empty}}" class="list">
    <view wx:for="{{list}}" wx:key="_id" class="item">
      <view class="time">{{item.timeLabel}}</view>
      <view class="line">申请改为「{{item.toBreed}}」</view>
      <view class="line muted">当前展示：{{item.fromBreed || '待识别'}}</view>
      <view wx:if="{{item.recognizedBreed}}" class="line muted">当初识别：{{item.recognizedBreed}}</view>
      <view class="ops">
        <button
          class="op reject"
          data-id="{{item._id}}"
          data-cardid="{{item.cardId}}"
          bindtap="onReject"
        >驳回</button>
        <button
          class="op ok"
          data-id="{{item._id}}"
          data-cardid="{{item.cardId}}"
          bindtap="onApprove"
        >通过</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{ready}}" class="empty-card">
    <empty-state main="暂无待审申请" sub="图鉴里换品种后，会出现在这里" />
  </view>

  <cat-loading show="{{pageLoading}}" text="{{loadingText}}" />
</view>
