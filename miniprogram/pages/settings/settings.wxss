.settings {
  background: #f5f7fa !important;
}

.head {
  margin-bottom: 20rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2430;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b95a5;
}

.hero {
  height: 220rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(70, 100, 140, 0.12);
}

.hero-img {
  width: 100%;
  height: 100%;
}

.group {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 14rpx 32rpx rgba(70, 100, 140, 0.1);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx 28rpx;
  border-bottom: 2rpx solid rgba(120, 140, 170, 0.08);
}

.row.last {
  border-bottom: none;
}

.row-main {
  flex: 1;
}

.row-title {
  font-size: 28rpx;
  color: #1f2430;
  font-weight: 700;
}

.row-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b95a5;
  line-height: 1.4;
}
