/* 足迹 · 猫咪相遇手帐 */

.map-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
}

.map {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* ================= 纸色薄雾（不拦截触摸） ================= */

.map-wash,
.map-veil {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
}

.map-wash { z-index: 2; }
.map-veil { z-index: 3; }

.map-wash-top {
  top: 0;
  height: 28%;
  background: linear-gradient(180deg, rgba(251, 247, 240, 0.5) 0%, rgba(251, 247, 240, 0) 100%);
}

.map-wash-bottom {
  bottom: 0;
  height: 32%;
  background: linear-gradient(0deg, rgba(251, 247, 240, 0.55) 0%, rgba(251, 247, 240, 0) 100%);
}

.map-veil-top {
  top: 0;
  height: 240rpx;
  background: linear-gradient(180deg, rgba(251, 247, 240, 0.9) 0%, rgba(251, 247, 240, 0.4) 55%, rgba(251, 247, 240, 0) 100%);
}

.map-veil-bottom {
  bottom: 0;
  height: 260rpx;
  background: linear-gradient(0deg, rgba(251, 247, 240, 0.8) 0%, rgba(251, 247, 240, 0.2) 55%, rgba(251, 247, 240, 0) 100%);
}

/* ================= 顶栏 ================= */

.nav-bar {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 10;
  box-sizing: border-box;
}

.nav-inner {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0 var(--space-3);
  padding-right: 200rpx;
  box-sizing: border-box;
}

.nav-btn {
  flex-shrink: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  border: 3rpx solid var(--color-title);
  box-shadow: 0 4rpx 0 rgba(43, 38, 34, 0.9);
  box-sizing: border-box;
}

.nav-back {
  width: 64rpx;
  border-radius: 50%;
}

.nav-back-chevron {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid var(--color-title);
  border-bottom: 4rpx solid var(--color-title);
  transform: rotate(45deg);
  margin-left: 6rpx;
  box-sizing: border-box;
}

.nav-title-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.nav-title {
  padding: 6rpx 18rpx;
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-title);
  letter-spacing: 2rpx;
  line-height: 1.2;
  background: linear-gradient(transparent 58%, rgba(141, 184, 232, 0.45) 58%, rgba(141, 184, 232, 0.45) 92%, transparent 92%);
}

.nav-settings {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--color-title);
}

/* ================= 顶部小胶囊 ================= */

.privacy-chip,
.count-chip,
.repair-chip {
  position: absolute;
  left: var(--space-3);
  z-index: 10;
  height: 48rpx;
  font-size: var(--font-xs);
  box-shadow: var(--shadow-card);
}

.privacy-chip {
  color: var(--color-sky-ink);
  background: var(--color-sky-soft);
  border-color: rgba(58, 110, 168, 0.18);
}

.count-chip {
  color: var(--color-title);
  font-weight: 700;
}

.repair-chip {
  color: #102418;
  font-weight: 700;
  background: linear-gradient(180deg, #5aef9a 0%, #2fd074 100%);
  border-color: rgba(255, 255, 255, 0.55);
  max-width: 72%;
}

.chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-sky);
}

.chip-ico {
  width: 28rpx;
  height: 28rpx;
}

/* ================= 定位按钮 ================= */

.side-tools {
  position: absolute;
  right: var(--space-3);
  bottom: calc(300rpx + env(safe-area-inset-bottom));
  z-index: 11;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  pointer-events: none;
}

.camera-readout {
  box-sizing: border-box;
  width: 190rpx;
  padding: 10rpx 14rpx;
  border: 2rpx solid var(--color-line);
  border-radius: 18rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  color: var(--color-text-2);
  font-size: var(--font-xs);
  line-height: 1.55;
}

.camera-readout-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
}

.camera-readout-value {
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  color: var(--color-title);
}

.tool-btn {
  pointer-events: auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: var(--color-surface);
  border: 3rpx solid var(--color-title);
  box-shadow: 0 5rpx 0 rgba(43, 38, 34, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.i-locate {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.i-locate-ring {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-title);
  box-sizing: border-box;
}

.i-locate-dot {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.i-locate-arm {
  position: absolute;
  background: var(--color-title);
  border-radius: 2rpx;
}

.i-locate-n,
.i-locate-s {
  left: 16rpx;
  width: 4rpx;
  height: 8rpx;
}

.i-locate-n { top: 0; }
.i-locate-s { bottom: 0; }

.i-locate-w,
.i-locate-e {
  top: 16rpx;
  width: 8rpx;
  height: 4rpx;
}

.i-locate-w { left: 0; }
.i-locate-e { right: 0; }

/* ================= 空状态 ================= */

.empty-tip {
  position: absolute;
  left: var(--space-4);
  right: var(--space-4);
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10;
  padding: var(--space-4) var(--space-4) var(--space-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: var(--shadow-float);
}

.empty-tip-illus {
  width: 300rpx;
  height: 230rpx;
}

.empty-tip .empty-title {
  margin-top: var(--space-1);
}

.empty-tip-cta {
  margin-top: var(--space-3);
  min-width: 240rpx;
}

/* ================= 共用：贴纸缩略 ================= */

.thumb {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background:
    radial-gradient(rgba(120, 95, 70, 0.1) 2rpx, transparent 2rpx) 0 0 / 20rpx 20rpx,
    var(--color-bg-deep);
}

.thumb-img {
  width: 88%;
  height: 88%;
}

.thumb-ph {
  width: 64%;
  height: 64%;
  opacity: 0.55;
}

.sheet-link {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-primary-ink);
  padding: 8rpx 4rpx;
}

.sheet-foot-space {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* ================= 聚合点多猫列表 ================= */

.cluster-mask {
  z-index: 900;
}

.cluster-sheet {
  max-height: 64vh;
  display: flex;
  flex-direction: column;
}

.cluster-sub {
  margin: 4rpx 0 var(--space-3);
}

.cluster-scroll {
  flex: 1;
  max-height: 48vh;
}

.cluster-item {
  min-height: 132rpx;
  padding: var(--space-2) var(--space-3);
}

.cluster-thumb {
  width: 100rpx;
  height: 100rpx;
}

.cluster-name {
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--color-title);
}

/* ================= 底栏卡片 ================= */

.bubble-dock {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 12;
}

.bubble-dock-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-5) var(--space-2);
}

.bubble-dock-title {
  height: 48rpx;
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--color-title);
  box-shadow: var(--shadow-card);
}

.bubble-swiper {
  height: 236rpx;
}

.bubble-slide {
  height: 208rpx;
  margin: 12rpx 10rpx 0;
  padding: var(--space-2) var(--space-3);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  box-sizing: border-box;
  overflow: visible;
  transform: scale(0.94);
  opacity: 0.85;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.bubble-slide-on {
  transform: scale(1);
  opacity: 1;
  box-shadow: var(--shadow-float);
}

.bubble-slide-single {
  margin: 0 var(--space-4);
  transform: none;
  opacity: 1;
  box-shadow: var(--shadow-float);
}

.bubble-thumb {
  width: 156rpx;
  height: 156rpx;
}

.bubble-meta {
  flex: 1;
  min-width: 0;
  padding-right: 64rpx;
}

.bubble-name {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-title);
  line-height: 1.3;
}

.bubble-sub {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-2);
  line-height: 1.4;
}

.bubble-seal {
  margin-top: 8rpx;
}

.bubble-hint {
  margin-top: 8rpx;
  color: var(--color-primary-ink);
}

/* 小号邮戳：右上角斜盖 */
.mini-stamp {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  width: 100rpx;
  height: 100rpx;
}

.mini-stamp .stamp-k {
  letter-spacing: 1rpx;
}

.mini-stamp .stamp-v {
  font-size: var(--font-sm);
}

/* ================= 相遇详情 ================= */

.detail-mask {
  z-index: 1100;
  padding: 72rpx var(--space-4) calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-card {
  width: 100%;
  max-height: 84vh;
  box-shadow: var(--shadow-float);
  animation: pop-in 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.detail-scroll {
  max-height: 84vh;
  border-radius: var(--radius-lg);
}

.detail-stage {
  position: relative;
  height: 440rpx;
  margin: var(--space-4) var(--space-4) 0;
  border-radius: var(--radius-md);
  background:
    radial-gradient(rgba(120, 95, 70, 0.1) 2rpx, transparent 2rpx) 0 0 / 28rpx 28rpx,
    var(--color-bg-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-hero {
  width: 82%;
  height: 86%;
}

.detail-hero-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
}

.detail-hero-ph {
  width: 180rpx;
  height: 180rpx;
  opacity: 0.5;
}

.detail-stamp {
  position: absolute;
  right: -12rpx;
  bottom: -24rpx;
}

.detail-stamp .stamp-k {
  letter-spacing: 2rpx;
}

.detail-stamp .stamp-v {
  font-size: var(--font-md);
}

.detail-body {
  padding: var(--space-4);
}

.detail-head {
  padding-right: 120rpx;
}

.detail-rows {
  margin-top: var(--space-3);
  border-top: 2rpx dashed var(--color-line);
}

.detail-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
  padding: 20rpx 0;
  border-bottom: 2rpx dashed var(--color-line);
}

.detail-k {
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: var(--color-muted);
}

.detail-v {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-title);
  word-break: break-all;
}

.detail-v-muted {
  color: var(--color-muted);
  font-weight: 400;
}

.detail-geo {
  margin-top: var(--space-3);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-note {
  margin-top: var(--space-3);
  font-size: var(--font-md);
  line-height: 1.6;
}

.detail-note-plain {
  margin-top: var(--space-3);
}

.detail-archive {
  margin-top: var(--space-4);
}

.detail-foot {
  margin-top: var(--space-2);
  text-align: center;
}

/* ================= 地图设置 ================= */

.sheet-mask {
  z-index: 1000;
}

.settings-sheet {
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.sheet-note {
  margin-top: 4rpx;
}

.sheet-scroll {
  flex: 1;
  max-height: 48vh;
  margin-top: var(--space-2);
}

.settings-save-bar {
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
}

.settings-save-btn {
  text-align: center;
}

.group-title {
  margin: var(--space-3) 0 var(--space-1) 8rpx;
  font-size: var(--font-sm);
  font-weight: 800;
  color: var(--color-text-2);
  letter-spacing: 2rpx;
}

.opt-row {
  padding: var(--space-2) var(--space-3);
}

.opt-name {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-title);
}

.opt-desc {
  margin-top: 2rpx;
  font-size: var(--font-xs);
  color: var(--color-muted);
  line-height: 1.4;
}

.switch {
  flex-shrink: 0;
  position: relative;
  width: 88rpx;
  height: 48rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg-deep);
  border: 2rpx solid var(--color-line);
  box-sizing: border-box;
  transition: background 0.2s ease;
}

.switch-knob {
  position: absolute;
  left: 4rpx;
  top: 2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(90, 60, 30, 0.2);
  transition: transform 0.2s ease;
}

.switch-on {
  background: var(--color-mint);
  border-color: var(--color-mint);
}

.switch-on .switch-knob {
  transform: translateX(38rpx);
}

.range-row {
  display: block;
  padding: var(--space-2) var(--space-3);
}

.range-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.range-btns {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-top: var(--space-1);
}

.range-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-title);
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-title);
  box-sizing: border-box;
}

.range-slider {
  flex: 1;
  margin: 0 12rpx;
}
