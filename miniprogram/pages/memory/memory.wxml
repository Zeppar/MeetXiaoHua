<view class="page page-sub memory">
  <!-- 页眉：贴着它的照片 -->
  <view class="header paper anim-rise" wx:if="{{card}}">
    <view class="header-photo">
      <view class="tape tape-blush header-tape"></view>
      <image class="avatar sticker tilt-l" src="{{displayImage}}" mode="aspectFit" />
    </view>
    <view class="grow">
      <view class="h3 ellipsis">和{{displayName || '它'}}的记忆</view>
      <view class="caption mt-1">{{card.breed}}</view>
      <view wx:if="{{memories.length}}" class="tiny mt-1">共 {{memories.length}} 段 · 长按一段可删除</view>
    </view>
  </view>

  <view wx:if="{{ready && memories.length}}" class="entries">
    <view
      wx:for="{{memories}}"
      wx:key="_id"
      class="entry paper lined anim-rise"
      data-id="{{item._id}}"
      bindlongpress="onLongDelete"
    >
      <view class="entry-head">
        <text class="tag tag-blush">{{item.timeLabel}}</text>
      </view>
      <view class="entry-text hand">{{item.text}}</view>
      <view
        wx:if="{{item.imagePath}}"
        class="polaroid {{index % 2 === 0 ? 'tilt-r' : 'tilt-l'}}"
        hover-class="tap-press"
        data-src="{{item.imagePath}}"
        bindtap="onPreviewImg"
      >
        <view class="tape {{index % 2 === 0 ? 'tape-mint' : 'tape-sky'}} polaroid-tape"></view>
        <image class="polaroid-img" src="{{item.imagePath}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <empty-state
    wx:elif="{{ready}}"
    illus="/assets/art/empty-memory.svg"
    main="{{emptyMain}}"
    sub="{{emptySub}}"
    button-text="{{addFirst}}"
    bind:action="onAdd"
  />

  <!-- 有记忆时才放底部按钮；空状态自带「添加第一条记忆」，一屏只留一个主按钮 -->
  <view wx:if="{{ready && memories.length}}" class="footer safe-bottom">
    <button class="btn-primary btn-block" bindtap="onAdd">{{addText}}</button>
  </view>

  <text-modal
    show="{{showAdd}}"
    title="添加记忆"
    placeholder="写下和它有关的小事…"
    value="{{draft}}"
    maxlength="{{max}}"
    cancel-text="取消"
    confirm-text="保存"
    extra="{{pickImageText}}"
    bind:cancel="onCancelAdd"
    bind:confirm="onConfirmAdd"
    bind:input="onDraftInput"
    bind:extra="onPickImage"
  />

  <cat-loading show="{{pageLoading}}" text="{{loadingText}}" />
</view>
