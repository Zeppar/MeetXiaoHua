/* 记忆角 · 横线本上的日记 */

.memory {
  padding-top: var(--space-5);
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* ===== 页眉 ===== */
.header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
}

.header-photo {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: var(--color-bg-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-tape {
  width: 90rpx;
  height: 28rpx;
  margin-left: -45rpx;
  top: -12rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
}

/* ===== 日记条目 ===== */
.entries {
  margin-top: var(--space-4);
}

.entry {
  margin-bottom: var(--space-4);
  /* 顶部不留白：日期占第一行，正文正好落在横线上 */
  padding: 0 var(--space-4) var(--space-4);
  overflow: visible;
}

.entry-head {
  display: flex;
  height: 56rpx;
  align-items: center;
}

.entry-text {
  font-size: var(--font-lg);
  color: var(--color-text);
  line-height: 56rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 拍立得 */
.polaroid {
  position: relative;
  width: 360rpx;
  margin: var(--space-4) auto var(--space-1);
  padding: 14rpx 14rpx 56rpx;
  background: var(--color-surface);
  border-radius: 6rpx;
  box-shadow: 0 10rpx 22rpx rgba(80, 50, 20, 0.18);
  box-sizing: border-box;
}

.polaroid-tape {
  width: 110rpx;
  height: 32rpx;
  margin-left: -55rpx;
  top: -14rpx;
}

.polaroid-img {
  display: block;
  width: 332rpx;
  height: 332rpx;
  background: var(--color-bg-deep);
}

/* ===== 底部按钮 ===== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: var(--space-4) var(--space-4) var(--space-3);
  background: linear-gradient(180deg, rgba(251, 247, 240, 0) 0%, var(--color-bg) 36%);
}

.footer.safe-bottom {
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
}
