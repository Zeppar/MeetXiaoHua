/* 图鉴 · 猫咪相遇手帐 */

.album {
  min-height: 100vh;
}

/* ===== 自定义导航 ===== */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  box-sizing: border-box;
  background: var(--color-bg);
  border-bottom: 2rpx dashed var(--color-line);
}

.nav-inner {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0 200rpx 0 var(--space-3);
  box-sizing: border-box;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn-ico {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-title);
  letter-spacing: 2rpx;
}

.nav-link {
  flex-shrink: 0;
  padding: 8rpx 4rpx;
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-primary-ink);
}

.debug-btn {
  position: fixed;
  left: 300rpx;
  z-index: 99;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-title);
  color: var(--color-surface);
  font-size: var(--font-2xs);
  font-weight: 700;
  opacity: 0.78;
}

/* ===== 主展示：贴在纸上的那只 ===== */
.feature {
  margin-top: var(--space-4);
  padding: var(--space-5) var(--space-4) var(--space-3);
}

.feature-stage {
  position: relative;
  height: 460rpx;
}

.feature-photo {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-img {
  width: 100%;
  height: 100%;
}

/* 没抠图的原图：手动加一圈白边，也像贴纸 */
.feature-img-raw {
  width: 400rpx;
  height: 400rpx;
  border: 12rpx solid var(--color-surface);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.feature-lost {
  width: 360rpx;
  height: 360rpx;
  border-radius: var(--radius-lg);
  border: 3rpx dashed var(--color-line);
  background: var(--color-bg-deep);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
}

.feature-lost-illus {
  width: 140rpx;
  height: 164rpx;
}

.feature-lost-tip {
  font-size: var(--font-sm);
  color: var(--color-primary-ink);
  font-weight: 700;
}

.feature-stamp {
  position: absolute;
  right: -8rpx;
  top: -12rpx;
  z-index: 3;
}

.feature-seal {
  position: absolute;
  left: 0;
  bottom: 24rpx;
  z-index: 3;
  background: var(--color-surface);
}

/* 猫说的话：手写小便签 */
.feature-bubble {
  position: absolute;
  right: 0;
  bottom: 8rpx;
  z-index: 3;
  max-width: 300rpx;
  padding: 10rpx 20rpx;
  border-radius: 6rpx 6rpx 22rpx 6rpx;
  background: var(--color-note);
  box-shadow: 0 8rpx 14rpx rgba(120, 95, 40, 0.12);
  font-size: var(--font-sm);
  color: var(--color-text);
  transform: rotate(2deg);
}

.feature-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  margin-top: var(--space-3);
}

.feature-place {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-text-2);
}

.feature-hint {
  text-align: center;
}

/* 名字 / 品种 / 去向 */
.rows {
  margin-top: var(--space-3);
  border-top: 2rpx dashed var(--color-line);
}

.info-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 92rpx;
  border-bottom: 2rpx dashed var(--color-line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-k {
  width: 72rpx;
  flex-shrink: 0;
  font-size: var(--font-xs);
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.info-v {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-title);
}

.is-muted {
  color: var(--color-muted);
  font-weight: 500;
}

.info-act {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 52rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--radius-pill);
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
  font-size: var(--font-sm);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-act-quiet {
  background: transparent;
  border: 2rpx solid var(--color-line);
  color: var(--color-text-2);
}

/* ===== 收集进度 ===== */
.collect-num {
  font-size: var(--font-xl);
  color: var(--color-primary-ink);
}

.collect {
  padding: var(--space-3) var(--space-3) var(--space-2);
}

.collect-bar {
  margin: 0 var(--space-1) var(--space-3);
}

.slots {
  display: flex;
  flex-wrap: wrap;
}

.slot {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: var(--space-2);
  box-sizing: border-box;
}

.slot-pic {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 2rpx dashed var(--color-line);
  background: var(--color-bg-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-met .slot-pic {
  border: 3rpx solid var(--color-mint);
  background: var(--color-mint-soft);
}

.slot-illus {
  width: 72rpx;
  height: 84rpx;
}

.slot-illus-off {
  opacity: 0.8;
}

.slot-name {
  max-width: 100%;
  margin-top: var(--space-1);
  font-size: var(--font-2xs);
  color: var(--color-muted);
}

.slot-met .slot-name {
  color: var(--color-title);
  font-weight: 800;
}

/* ===== 品种筛选 ===== */
.chips {
  white-space: nowrap;
  margin: 0 calc(-1 * var(--space-4));
  padding: 4rpx var(--space-4) var(--space-2);
  width: auto;
  display: flex;
}

.chip-item {
  margin-right: var(--space-2);
  flex-shrink: 0;
}

.chip-count {
  font-size: var(--font-2xs);
  opacity: 0.7;
}

/* ===== 猫格子 ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: var(--space-2);
}

.tile {
  position: relative;
  width: 31.5%;
  margin-bottom: var(--space-3);
  padding: var(--space-2) var(--space-1) var(--space-2);
  box-sizing: border-box;
  border-radius: var(--radius-md);
}

.tile-on {
  border: 3rpx solid var(--color-primary);
  background: var(--color-primary-soft);
}

.tile-pic {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile-img {
  width: 100%;
  height: 100%;
}

.tile-img-raw {
  width: 160rpx;
  height: 160rpx;
  border: 8rpx solid var(--color-surface);
  border-radius: 8rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 12rpx rgba(80, 50, 20, 0.16);
}

.tile-lost {
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--radius-sm);
  border: 3rpx dashed var(--color-line);
  background: var(--color-bg-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile-lost-tip {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-primary-ink);
}

.tile-seal {
  position: absolute;
  top: 8rpx;
  right: 4rpx;
  background: var(--color-surface);
}

.tile-name {
  margin-top: var(--space-1);
  text-align: center;
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--color-title);
}

/* ===== 空状态 ===== */
.empty-btn {
  margin-top: var(--space-5);
  width: 400rpx;
}

/* ===== 品种选择面板 ===== */
.sheet-hd {
  margin-bottom: var(--space-3);
}

.sheet-close {
  padding: 8rpx 4rpx;
  font-size: var(--font-md);
  color: var(--color-text-2);
}

.breed-list {
  max-height: 60vh;
}

.breed-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding-bottom: var(--space-2);
}

.breed-opt {
  height: 72rpx;
  padding: 0 32rpx;
  font-size: var(--font-md);
}
