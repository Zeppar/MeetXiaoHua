<view class="album">
  <!-- 自定义导航：标题与胶囊对齐 -->
  <view class="nav-bar" style="padding-top: {{statusBar}}px; height: {{navBarHeight}}px;">
    <view class="nav-inner" style="height: {{navHeight}}px;">
      <view class="nav-btn" hover-class="tap-press" catchtap="onMap" aria-role="button" aria-label="足迹地图">
        <image class="nav-btn-ico" src="/assets/icons/outing.svg" mode="aspectFit" />
      </view>
      <text class="nav-title">我的图鉴</text>
      <view class="nav-link" hover-class="tap-press" catchtap="onReleased" aria-role="button" aria-label="我放生的猫">放生记录</view>
    </view>
  </view>
  <view class="page album-page" style="padding-top: {{navPad}}px;">
    <!-- 有猫 -->
    <block wx:if="{{ready && hasCats}}">
      <!-- 本页主角：贴在手帐上的那只 -->
      <view wx:if="{{featured}}" class="feature paper anim-rise">
        <view class="tape tape-left"></view>

        <view class="feature-stage">
          <view class="feature-photo" hover-class="tap-press" bindtap="onOpenFeatured">
            <image
              wx:if="{{featured.stickerImage || featured.displayImage}}"
              class="feature-img sticker tilt-l {{featured.isSticker ? '' : 'feature-img-raw'}}"
              src="{{featured.stickerImage || featured.displayImage}}"
              mode="aspectFit"
              binderror="onMediaError"
              data-id="{{featured._id}}"
              data-field="featured"
            />
            <view wx:else class="feature-lost" hover-class="tap-press" catchtap="onFixMedia" data-id="{{featured._id}}">
              <image class="feature-lost-illus" src="/assets/art/cat-shadow.svg" mode="aspectFit" />
              <text class="feature-lost-tip">图丢了，点这里补一张</text>
            </view>
          </view>

          <view class="stamp feature-stamp anim-stamp">
            <text class="stamp-k">{{featured.stampK}}</text>
            <text class="stamp-v">{{featured.stampV}}</text>
          </view>
          <view wx:if="{{featured.inRoom}}" class="seal seal-mint feature-seal">在小屋</view>

          <view class="feature-bubble hand" hover-class="tap-press" catchtap="onEditName">{{featured.hasName ? ('喵，我是' + featured.displayName) : '喵，给我起个名字吧'}}</view>
        </view>

        <view class="feature-meta">
          <text wx:if="{{featured.placeText}}" class="feature-place">在 {{featured.placeText}} 遇见</text>
          <text class="tiny feature-hint">轻点照片，翻开它的日记</text>
        </view>

        <view class="rows">
          <view class="info-row" hover-class="tap-press" catchtap="onEditName">
            <text class="info-k">名字</text>
            <text class="info-v ellipsis {{featured.hasName ? '' : 'is-muted'}}">{{featured.hasName ? featured.displayName : '还没有名字'}}</text>
            <text class="info-act">改名</text>
          </view>
          <view class="info-row" hover-class="tap-press" catchtap="onEditBreed">
            <text class="info-k">品种</text>
            <text class="info-v ellipsis {{featured.breedPending ? '' : (featured.breedUnknown ? 'is-muted' : '')}}">{{featured.breedPending ? ('申请换成 ' + (featured.pendingBreed || '新品种')) : (featured.breedUnknown ? '还没选品种' : featured.breed)}}</text>
            <text wx:if="{{featured.breedPending}}" class="seal seal-sky">审核中</text>
            <text wx:else class="info-act">{{featured.breedUnknown ? '选品种' : '换品种'}}</text>
          </view>
          <view wx:if="{{featured.needMedia}}" class="info-row" hover-class="tap-press" catchtap="onFixMedia" data-id="{{featured._id}}">
            <text class="info-k">照片</text>
            <text class="info-v is-muted">还没有图</text>
            <text class="info-act">补图</text>
          </view>
          <view class="info-row" hover-class="tap-press" catchtap="onRelease">
            <text class="info-k">去向</text>
            <text class="info-v {{featured.breedPending ? 'is-muted' : ''}}">{{featured.breedPending ? '审核中，先不能放生' : '放它回到街角'}}</text>
            <text wx:if="{{featured.breedPending}}" class="seal seal-muted">审核中</text>
            <text wx:else class="info-act info-act-quiet">放生</text>
          </view>
        </view>
      </view>

      <!-- 收集进度：每个品种一格 -->
      <view class="section-head">
        <view class="section-title"><text>已遇见 </text><text class="collect-num marker">{{collection.have}}</text><text> / {{collection.total}} 种猫</text></view>
        <text class="tiny">{{collection.have >= collection.total ? '全部集齐啦' : '街角还有新朋友'}}</text>
      </view>
      <view class="collect paper anim-rise delay-1">
        <view class="bar collect-bar">
          <view class="bar-fill" style="width: {{collection.percent}}%;"></view>
        </view>
        <view class="slots">
          <view
            wx:for="{{collection.breeds}}"
            wx:key="name"
            class="slot {{item.met ? 'slot-met' : ''}}"
          >
            <view class="slot-pic">
              <image
                class="slot-illus {{item.met ? '' : 'slot-illus-off'}}"
                src="{{item.met ? '/assets/art/cat-sit.svg' : '/assets/art/cat-shadow.svg'}}"
                mode="aspectFit"
              />
            </view>
            <text class="slot-name ellipsis {{item.met ? 'marker' : ''}}">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 我的猫：品种筛选 + 贴纸格子 -->
      <view class="section-head">
        <text class="section-title">我的猫</text>
        <text class="tiny">{{cards.length}} 只</text>
      </view>
      <scroll-view wx:if="{{filters.length}}" class="chips" scroll-x enable-flex show-scrollbar="{{false}}">
        <view
          wx:for="{{filters}}"
          wx:key="breed"
          class="chip chip-item {{(item.breed === '全部' ? !breedFilter : breedFilter === item.breed) ? 'chip-on' : ''}}"
          hover-class="tap-press"
          data-breed="{{item.breed}}"
          bindtap="onFilter"
        >
          <text>{{item.breed}}</text>
          <text wx:if="{{item.count}}" class="chip-count">{{item.count}}</text>
        </view>
      </scroll-view>

      <view class="grid">
        <view
          wx:for="{{cards}}"
          wx:key="_id"
          class="tile paper anim-rise {{featuredId === item._id ? 'tile-on' : ''}}"
          hover-class="tap-press"
          data-id="{{item._id}}"
          bindtap="onPick"
        >
          <view class="tile-pic">
            <image
              wx:if="{{item.displayImage}}"
              class="tile-img {{item.isSticker ? 'sticker' : 'tile-img-raw'}} {{index % 2 === 0 ? 'tilt-l' : 'tilt-r'}}"
              src="{{item.displayImage}}"
              mode="{{item.isSticker ? 'aspectFit' : 'aspectFill'}}"
              binderror="onMediaError"
              data-id="{{item._id}}"
              data-field="grid"
            />
            <view
              wx:else
              class="tile-lost"
              hover-class="tap-press"
              catchtap="onFixMedia"
              data-id="{{item._id}}"
            >
              <text class="tile-lost-tip">补图</text>
            </view>
          </view>
          <view wx:if="{{item.inRoom}}" class="seal seal-mint tile-seal">{{item.roomBadge || '在小屋'}}</view>
          <view class="tile-name ellipsis {{item.hasName ? '' : 'is-muted'}}">{{item.displayName}}</view>
        </view>
      </view>
    </block>

    <!-- 无猫：空状态 -->
    <view wx:elif="{{ready}}" class="empty anim-rise">
      <image class="empty-illus" src="/assets/art/empty-album.svg" mode="aspectFit" />
      <view class="empty-title">图鉴还是空白的</view>
      <view class="empty-sub">{{emptyTip}}</view>
      <button class="btn-primary empty-btn" bindtap="onGoShoot">{{goFirst}}</button>
    </view>
  </view>

  <cat-loading show="{{pageLoading}}" text="{{loadingText}}" />

  <text-modal
    show="{{showNameModal}}"
    title="{{nameTitle}}"
    placeholder="{{namePlaceholder}}"
    value="{{editNameValue}}"
    maxlength="{{nameMax}}"
    mode="input"
    cancel-text="取消"
    confirm-text="保存"
    bind:cancel="onNameCancel"
    bind:confirm="onNameConfirm"
  />

  <view wx:if="{{showBreedPicker}}" class="mask mask-bottom" catchtouchmove="noop" bindtap="onBreedCancel">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-grip"></view>
      <view class="row-between sheet-hd">
        <text class="h3">它是什么品种？</text>
        <text class="sheet-close" hover-class="tap-press" bindtap="onBreedCancel">取消</text>
      </view>
      <scroll-view scroll-y class="breed-list">
        <view class="breed-grid">
          <view
            wx:for="{{breedOptions}}"
            wx:key="*this"
            class="chip breed-opt {{featured.breed === item ? 'chip-on' : ''}}"
            hover-class="tap-press"
            data-breed="{{item}}"
            bindtap="onPickBreed"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
