.released {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2430;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b95a5;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 20rpx;
  box-shadow: 0 12rpx 28rpx rgba(70, 100, 140, 0.08);
}

.card-media {
  width: 160rpx;
  height: 160rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #eef3f8;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-img {
  width: 100%;
  height: 100%;
}

.card-ph {
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, #ffe0d0, #ffb8a8);
}

.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2430;
}

.card-meta {
  font-size: 22rpx;
  color: #5a6575;
}

.card-meta.muted {
  color: #8b95a5;
}

.status {
  margin-top: 8rpx;
  align-self: flex-start;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status-wandering {
  background: rgba(120, 140, 170, 0.12);
  color: #5a6575;
}

.status-visiting {
  background: rgba(94, 200, 232, 0.18);
  color: #1a7a96;
}

.status-adopted {
  background: rgba(47, 208, 116, 0.16);
  color: #1a8f4c;
}

.empty-card {
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(70, 100, 140, 0.1);
  padding: 24rpx 12rpx;
}
