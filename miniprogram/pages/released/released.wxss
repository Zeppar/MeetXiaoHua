/* 我放生的猫：每只猫是一张寄出去的明信片 */

.head {
  margin: var(--space-2) 0 var(--space-4);
}

.cards {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.rel-card {
  padding: var(--space-4) var(--space-4) var(--space-3);
}

.rel-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rel-k {
  letter-spacing: 4rpx;
  font-weight: 700;
}

.rel-main {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-2);
}

.rel-media {
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rel-img {
  width: 168rpx;
  height: 168rpx;
}

.rel-ph {
  width: 128rpx;
  height: 128rpx;
  opacity: 0.6;
}

.rel-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.rel-meta {
  font-size: var(--font-sm);
  font-weight: 700;
}

.rel-stamp {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.rel-stamp .stamp-v {
  font-size: var(--font-md);
}

.rel-year {
  font-size: var(--font-2xs);
  font-weight: 700;
  line-height: 1.1;
}

.rel-note {
  margin-top: var(--space-3);
  padding-top: var(--space-2);
  border-top: 2rpx dashed var(--color-line);
  font-size: var(--font-md);
  color: var(--color-text-2);
  line-height: 1.6;
}

.empty-wrap {
  margin-top: var(--space-5);
}
