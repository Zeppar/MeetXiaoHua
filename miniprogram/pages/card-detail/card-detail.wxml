<view class="detail-root">
  <view class="page page-sub detail" wx:if="{{card}}">
    <!-- 一页日记 -->
    <view class="diary paper anim-rise">
      <view class="tape"></view>

      <!-- 贴纸：轻触看大图，长按保存 -->
      <view class="photo" bindlongpress="onLongPress" bindtap="onLongPress">
        <image class="photo-img sticker tilt-l" src="{{displayImage}}" mode="aspectFit" />
        <view class="stamp photo-stamp anim-stamp">
          <text class="stamp-k">{{stampK}}</text>
          <text class="stamp-v">{{stampV}}</text>
        </view>
        <view wx:if="{{isInRoom}}" class="seal seal-mint photo-seal">{{roomTag || '在小屋'}}</view>
        <view wx:elif="{{card.memoryCount > 0}}" class="seal seal-blush photo-seal">记忆 {{card.memoryCount}}</view>
      </view>
      <view class="tiny photo-hint">轻触看大图 · 长按可保存</view>

      <!-- 名字 -->
      <view class="name-row">
        <text class="h1 name ellipsis {{card.name ? '' : 'name-empty'}}">{{card.name ? displayName : '还没有名字'}}</text>
        <view class="mini-act" hover-class="tap-press" bindtap="onEditName">{{card.name ? '改名' : '起名字'}}</view>
      </view>

      <!-- 品种 -->
      <view class="breed-row" hover-class="tap-press" bindtap="onEditBreed">
        <text class="breed-k">品种</text>
        <text class="breed-v ellipsis {{needPickBreed ? 'is-muted' : ''}}">{{breedPending ? ('申请换成 ' + (pendingBreed || '新品种')) : (needPickBreed ? '还没选品种' : card.breed)}}</text>
        <text wx:if="{{breedPending}}" class="seal seal-sky">审核中</text>
        <text wx:else class="mini-act">{{needPickBreed ? '选品种' : '换品种'}}</text>
      </view>

      <view wx:if="{{recognizedBreed && recognizedBreed !== card.breed}}" class="tip">识别结果：{{recognizedBreed}}</view>

      <!-- 熟面孔：遇见几次、认识几天、它的地盘 -->
      <view class="faces-line">
        <text class="seal seal-blush">第 {{encounterCount}} 次遇见</text>
        <text class="tiny">认识 {{knownDays || 1}} 天{{lastSeenLabel ? (' · 最近一次 ' + lastSeenLabel) : ''}}</text>
      </view>
      <view wx:if="{{territory}}" class="tiny faces-territory">它的地盘：{{territory}}</view>

      <!-- 还没有地点：用户自己补，不替他猜 -->
      <view wx:if="{{needPlace}}" class="place-card">
        <view class="place-title">想在足迹地图上看到你们在哪相遇吗？</view>
        <view class="tiny">地点会模糊到街区，只有你自己能看到</view>
        <view class="action-pair place-actions">
          <button wx:if="{{canPlaceHere}}" class="btn-secondary btn-sm grow" bindtap="onPlaceHere">记下这里</button>
          <button class="btn-secondary btn-sm grow" bindtap="onPlacePick">在地图上选</button>
        </view>
      </view>

      <!-- 相遇信息 -->
      <view class="meta">
        <text wx:if="{{shotLabel}}" class="tag tag-muted">{{shotLabel}}</text>
        <text wx:if="{{card.placeText && card.placeText !== '已记录当前位置'}}" class="tag tag-sky">{{card.placeText}}</text>
        <text wx:if="{{showConfidence}}" class="tag tag-muted">置信度 {{card.confidence}}%</text>
      </view>

      <view wx:if="{{card.mattingFailed}}" class="tip">{{mattingFailed}}</view>

      <!-- 亲密度：一排爪印 -->
      <view wx:if="{{intimacyText}}" class="bond">
        <view class="row-between">
          <text class="bond-k">亲密度</text>
          <text class="bond-text">{{intimacyText}}</text>
        </view>
        <view class="paws">
          <image
            wx:for="{{intimacyPaws}}"
            wx:key="i"
            class="paw {{item.on ? 'paw-on' : ''}}"
            src="/assets/icons/{{item.on ? 'paw-fill' : 'paw'}}.svg"
            mode="aspectFit"
          />
        </view>
      </view>

      <!-- 备注便签 -->
      <view wx:if="{{card.note}}" class="note detail-note" hover-class="tap-press" bindtap="onEditNote">{{card.note}}</view>
      <view wx:else class="note-blank" hover-class="tap-press" bindtap="onEditNote">
        <text class="hand">写一句关于它的话…</text>
      </view>
    </view>

    <!-- 入口 -->
    <view class="section-head">
      <text class="section-title">相遇与回忆</text>
    </view>
    <view class="list">
      <view class="list-row" hover-class="list-row-press" bindtap="onMemory">
        <view class="list-ico ico-blush">
          <image src="/assets/icons/memory.svg" />
        </view>
        <text class="list-title">{{memoryBtn}}</text>
        <text class="list-sub">{{card.memoryCount || 0}} 条记忆</text>
        <view class="list-arrow"></view>
      </view>
      <view class="list-row" hover-class="list-row-press" bindtap="onOutingHistory">
        <view class="list-ico ico-sky">
          <image src="/assets/icons/paw.svg" />
        </view>
        <text class="list-title">出门记录</text>
        <text class="list-sub">{{outingEntry}}</text>
        <view class="list-arrow"></view>
      </view>
    </view>

    <!-- 操作 -->
    <view class="actions">
      <block wx:if="{{!isInRoom && roomUnlocked}}">
        <button class="btn-primary btn-block" bindtap="onAddToRoom">{{setDisplay}}</button>
        <button class="btn-secondary btn-block" bindtap="onEditNote">{{editNote}}</button>
      </block>
      <!-- 小屋还没解锁（不到 2 只猫）：先不提小屋 -->
      <block wx:elif="{{!isInRoom}}">
        <button class="btn-primary btn-block" bindtap="onEditNote">{{editNote}}</button>
        <view class="tiny room-hint">再遇见一只猫，就能给它们一个小屋</view>
      </block>
      <block wx:else>
        <view class="room-status">
          <text class="seal seal-mint">{{roomTag || '在小屋里'}}</text>
          <text class="muted">它正在你的小屋里待着</text>
        </view>
        <view class="action-pair">
          <button class="btn-secondary grow" bindtap="onEditNote">{{editNote}}</button>
          <button class="btn-secondary grow" bindtap="onRemoveFromRoom">{{removeFromRoom}}</button>
        </view>
      </block>
      <view class="action-pair share-pair">
        <button class="btn-secondary grow" open-type="share" data-kind="invite">邀请好友接待它</button>
        <button class="btn-secondary grow" open-type="share" data-kind="card">分享猫卡</button>
      </view>
      <button class="btn-soft btn-block poster-btn" bindtap="onMakePoster">生成海报（发朋友圈、小红书）</button>
      <!-- 送去流浪是低频操作：收进「更多」 -->
      <view class="more-link" hover-class="tap-press" bindtap="onMoreActions">更多操作 ›</view>
    </view>

    <text-modal
      show="{{showNameModal}}"
      title="{{nameTitle}}"
      placeholder="{{namePlaceholder}}"
      value="{{editNameValue}}"
      maxlength="{{nameMax}}"
      mode="input"
      cancel-text="取消"
      confirm-text="{{saveText}}"
      bind:cancel="onNameCancel"
      bind:confirm="onNameConfirm"
    />

    <text-modal
      show="{{showNoteModal}}"
      title="{{noteTitle}}"
      placeholder="{{notePlaceholder}}"
      value="{{editNoteValue}}"
      maxlength="{{noteMax}}"
      cancel-text="取消"
      confirm-text="{{saveText}}"
      bind:cancel="onNoteCancel"
      bind:confirm="onNoteConfirm"
    />

    <view wx:if="{{preview}}" class="mask preview" bindtap="closePreview">
      <image class="preview-img" src="{{displayImage}}" mode="aspectFit" catchtap="noop" />
      <button class="btn-primary preview-save" catchtap="onSaveAlbum">保存到相册</button>
      <text class="preview-close">轻触空白处关闭</text>
    </view>

    <view wx:if="{{showBreedPicker}}" class="mask mask-bottom" catchtouchmove="noop" bindtap="onBreedCancel">
      <view class="sheet-panel" catchtap="noop">
        <view class="sheet-grip"></view>
        <view class="row-between sheet-hd">
          <text class="h3">它是什么品种？</text>
          <text class="sheet-close" hover-class="tap-press" bindtap="onBreedCancel">取消</text>
        </view>
        <scroll-view scroll-y class="breed-list">
          <view class="breed-grid">
            <view
              wx:for="{{breedOptions}}"
              wx:key="*this"
              class="chip breed-opt {{card.breed === item ? 'chip-on' : ''}}"
              hover-class="tap-press"
              data-breed="{{item}}"
              bindtap="onPickBreed"
            >{{item}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <cat-loading show="{{pageLoading}}" text="{{loadingText}}" />

  <!-- 画海报和分享封面用，不显示 -->
  <canvas type="2d" id="posterCanvas" class="offscreen-canvas"></canvas>
  <canvas type="2d" id="coverCanvas" class="offscreen-canvas"></canvas>
</view>
