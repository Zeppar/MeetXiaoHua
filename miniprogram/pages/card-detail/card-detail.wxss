.detail-root {
  min-height: 100vh;
}

.detail {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 90% 40% at 50% -8%, rgba(120, 190, 255, 0.35), transparent 70%),
    linear-gradient(180deg, #d7ebff 0%, #eaf3fa 32%, #f3f6f9 62%, #f6f8fb 100%) !important;
}

/* —— 展示台 —— */
.hero {
  position: relative;
  height: 480rpx;
  border-radius: 36rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(165deg, #edf6ff 0%, #f8fcff 48%, #eef7f2 100%);
  box-shadow:
    0 18rpx 40rpx rgba(70, 110, 150, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.hero-sky {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.8), transparent 28%),
    radial-gradient(circle at 82% 18%, rgba(160, 220, 255, 0.35), transparent 26%);
  pointer-events: none;
}

.hero-glow {
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(47, 208, 116, 0.18) 0%, rgba(47, 208, 116, 0) 72%);
  pointer-events: none;
}

.hero-floor {
  position: absolute;
  left: 12%;
  right: 12%;
  bottom: 56rpx;
  height: 28rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(40, 60, 90, 0.14), transparent 70%);
  pointer-events: none;
}

.hero-img {
  position: relative;
  z-index: 1;
  width: 84%;
  height: 400rpx;
  filter: drop-shadow(0 16rpx 26rpx rgba(40, 60, 90, 0.16));
}

.hero-chip {
  position: absolute;
  z-index: 2;
  right: 22rpx;
  top: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1a8f4c;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(70, 110, 150, 0.1);
}

.hero-chip-room {
  background: rgba(47, 208, 116, 0.92);
  color: #102418;
}

.hero-hint {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(91, 104, 122, 0.62);
  letter-spacing: 1rpx;
}

/* —— 身份卡 —— */
.id-card {
  margin-top: -28rpx;
  position: relative;
  z-index: 3;
  padding: 28rpx 26rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 36rpx rgba(70, 110, 150, 0.1);
  backdrop-filter: blur(12px);
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.name {
  max-width: 460rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2430;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-edit {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(47, 208, 116, 0.14);
  color: #1a8f4c;
  font-size: 22rpx;
  font-weight: 700;
}

.bond-block {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(47, 208, 116, 0.1), rgba(120, 200, 255, 0.08));
}

.bond-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.bond-label {
  font-size: 22rpx;
  color: #5b687a;
  font-weight: 600;
}

.bond-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #1a8f4c;
}

.bond-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  overflow: hidden;
}

.bond-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5aef9a, #2fd074);
  min-width: 8rpx;
  transition: width 0.35s ease;
}

.breed-row {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #f4f7fa;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.breed-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.breed-label {
  font-size: 20rpx;
  color: #8b95a5;
}

.breed-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2430;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breed-action {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(47, 208, 116, 0.16);
  color: #1a8f4c;
  font-size: 22rpx;
  font-weight: 700;
}

.breed-row.is-pending {
  background: rgba(255, 244, 232, 0.95);
}

.breed-action.is-pending {
  background: rgba(232, 140, 60, 0.18);
  color: #c45a18;
}

.tip-banner {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 244, 232, 0.9);
  color: #c47a3a;
  font-size: 22rpx;
  line-height: 1.5;
}

.tip-banner.tip-warn {
  background: rgba(255, 236, 220, 0.95);
}

.breed-review-row {
  margin-top: 12rpx;
}

.btn-ghost {
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #1f2430;
  font-size: 26rpx;
  font-weight: 700;
  border: 2rpx solid #e6ebf1;
}

.btn-ghost::after {
  border: none;
}

.meta-chips {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: center;
}

.chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f0f3f7;
  color: #5b687a;
  font-size: 20rpx;
  font-weight: 600;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
  color: #3d4654;
  text-align: left;
  line-height: 1.65;
  font-size: 26rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.section-title {
  margin: 28rpx 8rpx 14rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #8b95a5;
  letter-spacing: 1rpx;
}

/* —— 入口 —— */
.links {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.link {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(70, 110, 150, 0.06);
}

.link-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.link-ico.mem {
  background: linear-gradient(160deg, #d7ecff, #8fc8ff);
}

.link-ico.out {
  background: linear-gradient(160deg, #ffe0ef, #ffb0cf);
}

.ico-spark {
  width: 18rpx;
  height: 18rpx;
  background: #fff;
  border-radius: 4rpx;
  transform: rotate(45deg);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.35);
}

.ico-paw {
  width: 22rpx;
  height: 16rpx;
  border-radius: 50% 50% 40% 40%;
  background: rgba(255, 255, 255, 0.95);
  position: relative;
}

.ico-paw::before,
.ico-paw::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  top: -8rpx;
}

.ico-paw::before {
  left: 2rpx;
}

.ico-paw::after {
  right: 2rpx;
}

.link-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.link-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2430;
}

.link-desc {
  font-size: 22rpx;
  color: #8b95a5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.link-arrow {
  color: #c0c7d2;
  font-size: 36rpx;
  padding-left: 8rpx;
}

/* —— 操作 —— */
.actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.actions-row {
  display: flex;
  gap: 14rpx;
}

.btn-half {
  flex: 1;
  margin: 0;
}

.btn-soft {
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2430;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(70, 110, 150, 0.06);
}

.btn-soft::after {
  border: none;
}

.btn-room {
  margin: 0;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.room-status {
  height: 88rpx;
  border-radius: 999rpx;
  background: rgba(47, 208, 116, 0.14);
  color: #1a8f4c;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.room-status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #2fd074;
  box-shadow: 0 0 0 6rpx rgba(47, 208, 116, 0.2);
}

.btn-release {
  margin: 0;
  background: transparent;
  color: #8b95a5;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
  padding: 8rpx 0 12rpx;
}

.btn-release::after {
  border: none;
}

.btn-release.is-disabled {
  color: #c45a18;
  opacity: 0.85;
}

/* —— 预览 / 品种 sheet —— */
.preview-mask {
  position: fixed;
  inset: 0;
  background: rgba(12, 18, 28, 0.9);
  z-index: 1500;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.preview-img {
  width: 100%;
  height: 70vh;
}

.save-album {
  margin-top: 32rpx;
  width: 60%;
}

.breed-mask {
  position: fixed;
  inset: 0;
  z-index: 1600;
  background: rgba(12, 18, 28, 0.45);
  display: flex;
  align-items: flex-end;
}

.breed-sheet {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e6ebf1;
  margin: 8rpx auto 18rpx;
}

.breed-sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.breed-sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2430;
}

.breed-sheet-close {
  font-size: 26rpx;
  color: #8b95a5;
  padding: 8rpx 12rpx;
}

.breed-sheet-list {
  max-height: 56vh;
}

.breed-option {
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #eef2f6;
  font-size: 30rpx;
  color: #1f2430;
  font-weight: 600;
}

.breed-option.on {
  color: #1a8f4c;
}

.breed-option:last-child {
  border-bottom: none;
}
