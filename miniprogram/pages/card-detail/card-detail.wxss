/* 猫咪详情 · 一页日记 */

.detail-root {
  min-height: 100vh;
}

.detail {
  padding-top: var(--space-5);
}

/* ===== 日记纸 ===== */
.diary {
  padding: var(--space-5) var(--space-4) var(--space-4);
}

.photo {
  position: relative;
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-img {
  width: 520rpx;
  height: 500rpx;
}

.photo-stamp {
  position: absolute;
  right: -12rpx;
  top: -16rpx;
  z-index: 3;
}

.photo-seal {
  position: absolute;
  left: 0;
  bottom: 16rpx;
  z-index: 3;
  background: var(--color-surface);
}

.photo-hint {
  margin-top: var(--space-1);
  text-align: center;
}

/* 名字 */
.name-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.name {
  flex: 1;
  min-width: 0;
}

.name-empty {
  color: var(--color-muted);
  font-weight: 700;
  font-size: var(--font-xl);
}

/* 小动作词：改名 / 换品种 */
.mini-act {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: var(--radius-pill);
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
  font-size: var(--font-sm);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 品种 */
.breed-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 84rpx;
  margin-top: var(--space-2);
  border-top: 2rpx dashed var(--color-line);
  border-bottom: 2rpx dashed var(--color-line);
}

.breed-k {
  flex-shrink: 0;
  font-size: var(--font-xs);
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.breed-v {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-title);
}

.is-muted {
  color: var(--color-muted);
  font-weight: 500;
}

.tip {
  margin-top: var(--space-2);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--color-bg-deep);
  font-size: var(--font-xs);
  color: var(--color-text-2);
  line-height: 1.6;
}

.review-row {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--space-1);
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin-top: var(--space-3);
}

/* 亲密度爪印 */
.bond {
  margin-top: var(--space-4);
}

.bond-k {
  font-size: var(--font-xs);
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.bond-text {
  font-size: var(--font-sm);
  font-weight: 800;
  color: var(--color-blush-ink);
}

.paws {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.paw {
  width: 64rpx;
  height: 64rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border-radius: 50%;
  opacity: 0.25;
}

.paw-on {
  opacity: 1;
  background: var(--color-primary-soft);
}

/* 备注 */
.detail-note {
  margin-top: var(--space-4);
  font-size: var(--font-md);
  line-height: 1.7;
}

.note-blank {
  margin-top: var(--space-4);
  padding: var(--space-3);
  border-radius: var(--radius-sm);
  border: 2rpx dashed var(--color-line);
  font-size: var(--font-md);
  color: var(--color-muted);
}

/* ===== 入口列表 ===== */
.ico-blush {
  background: var(--color-blush-soft);
}

.ico-sky {
  background: var(--color-sky-soft);
}

/* ===== 操作 ===== */
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-5);
}

.action-pair {
  display: flex;
  gap: var(--space-2);
}

/* 小程序 button 自带固定宽度，这里交给 flex 均分 */
.action-pair .grow {
  width: 0;
  flex: 1;
  padding: 0 16rpx;
}

.preview-save {
  width: 440rpx;
}

.room-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
}

.release-btn {
  color: var(--color-danger);
  font-size: var(--font-sm);
  opacity: 0.8;
}

.release-btn.is-disabled {
  color: var(--color-muted);
  opacity: 0.7;
}

/* ===== 大图预览 ===== */
.preview {
  flex-direction: column;
  gap: var(--space-4);
}

.preview-img {
  width: 680rpx;
  height: 820rpx;
}

.preview-close {
  font-size: var(--font-xs);
  color: var(--color-surface);
  opacity: 0.8;
}

/* ===== 品种选择面板 ===== */
.sheet-hd {
  margin-bottom: var(--space-3);
}

.sheet-close {
  padding: 8rpx 4rpx;
  font-size: var(--font-md);
  color: var(--color-text-2);
}

.breed-list {
  max-height: 60vh;
}

.breed-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding-bottom: var(--space-2);
}

.breed-opt {
  height: 72rpx;
  padding: 0 32rpx;
  font-size: var(--font-md);
}

/* 熟面孔 */
.faces-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-2);
}
.faces-territory {
  display: block;
  margin-top: 8rpx;
}

/* 分享 / 邀请 */
.share-pair {
  margin-top: var(--space-2);
}

/* 小屋未解锁提示 / 更多操作 */
.room-hint {
  display: block;
  text-align: center;
  margin-top: var(--space-2);
}
.more-link {
  margin-top: var(--space-3);
  padding: 12rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-muted);
}

/* 补地点 */
.place-card {
  margin-top: var(--space-3);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--color-line);
  background: var(--color-sky-soft);
}
.place-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-title);
  margin-bottom: 4rpx;
}
.place-actions {
  margin-top: var(--space-2);
}

/* 海报 */
.poster-btn {
  margin-top: var(--space-2);
}
.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1200px;
}
