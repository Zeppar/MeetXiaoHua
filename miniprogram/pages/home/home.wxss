/* 首页 · 今天 */

.home {
  padding-top: 0;
}

/* —— 顶栏 —— */
.topbar {
  margin: 0 calc(-1 * var(--space-4));
  padding-left: var(--space-4);
  padding-right: var(--space-4);
}

.brand-mark {
  width: 52rpx;
  height: 52rpx;
}

.brand-name {
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--color-title);
  letter-spacing: 2rpx;
}

/* —— 问候 —— */
.greet {
  margin-top: var(--space-4);
}

.greet-title {
  margin: 6rpx 0 4rpx;
}

/* —— 街角 —— */
.hero {
  margin-top: var(--space-4);
  padding: var(--space-3);
}

.hero-art {
  display: block;
  width: 100%;
  border-radius: var(--radius-md);
}

.hero-stats {
  margin: var(--space-3) 0;
  padding: var(--space-2) var(--space-1);
  border-top: 2rpx dashed var(--color-line);
  border-bottom: 2rpx dashed var(--color-line);
}

.hs {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.hs-num {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--color-primary-ink);
}

.hs-unit {
  font-size: var(--font-xs);
  color: var(--color-text-2);
}

.hs-sep {
  width: 2rpx;
  height: 40rpx;
  background: var(--color-line);
}

.cta-ico {
  width: 40rpx;
  height: 40rpx;
}

/* —— 我的猫现在 —— */
.now {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
}

.now-pic {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: var(--color-bg-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.now-img {
  width: 112rpx;
  height: 112rpx;
}

.now-away {
  background: var(--color-sky-soft);
}

.now-paw {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  opacity: 0.75;
}

.now-paw.p1 { left: 18rpx; bottom: 18rpx; transform: rotate(20deg); }
.now-paw.p2 { left: 52rpx; top: 46rpx; transform: rotate(32deg); }
.now-paw.p3 { right: 16rpx; top: 14rpx; transform: rotate(40deg); }

/* —— 明信片 / 便签 —— */
.report {
  margin-top: var(--space-3);
}

.report-stamp {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
}

.visit {
  margin-top: var(--space-3);
}

.visit-title {
  font-family: var(--font-body);
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--color-title);
}

.visit-body {
  margin-top: 6rpx;
  font-size: var(--font-md);
  line-height: 1.6;
}

.visit-go {
  margin-top: var(--space-2);
  font-family: var(--font-body);
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-primary-ink);
}

/* —— 最近遇见 —— */
.recent {
  margin: 0 calc(-1 * var(--space-4));
  width: auto;
  white-space: nowrap;
}

.recent-row {
  display: flex;
  gap: var(--space-2);
  padding: var(--space-1) var(--space-4) var(--space-3);
}

.rc {
  flex-shrink: 0;
  width: 220rpx;
  padding: var(--space-2) var(--space-2) var(--space-3);
  box-sizing: border-box;
}

.rc-pic {
  height: 200rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rc-img {
  width: 170rpx;
  height: 170rpx;
}

.rc-name {
  margin-top: var(--space-2);
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-title);
}

.recent-empty {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3);
}

.re-illus {
  width: 200rpx;
  height: 166rpx;
  flex-shrink: 0;
}

/* —— 翻翻手帐 —— */
.more-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  padding: var(--space-3);
}

.more-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-1);
}

.more-ico image {
  width: 38rpx;
  height: 38rpx;
}

.more-t {
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--color-title);
}

/* —— 隐私弹窗 —— */
.privacy {
  position: relative;
  text-align: center;
}

.privacy-art {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto var(--space-2);
  display: block;
}

.privacy-link {
  margin-top: var(--space-2);
  font-size: var(--font-sm);
  color: var(--color-primary-ink);
  text-decoration: underline;
}

/* 新用户首屏：只做「拍一只猫」 */
.first {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: var(--space-6);
  text-align: center;
}
.first-card {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.first-sticker {
  width: 320rpx;
  height: 320rpx;
}
.first-stamp {
  position: absolute;
  right: -24rpx;
  bottom: -24rpx;
}
.first-title {
  margin-top: var(--space-6);
  padding: 0 var(--space-3);
}
.first-sub {
  margin-top: var(--space-2);
}
.first-cta {
  margin-top: var(--space-6);
  width: 100%;
}
.first-album {
  margin-top: var(--space-4);
  padding: 12rpx;
  font-size: var(--font-sm);
  color: var(--color-text-2);
}
