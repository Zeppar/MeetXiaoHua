.share-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding-top: var(--space-5);
}

.from {
  text-align: center;
}

.card {
  position: relative;
  padding: var(--space-5) var(--space-4) var(--space-4);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pic {
  width: 440rpx;
  height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pic-img {
  width: 100%;
  height: 100%;
}

.pic-ghost {
  opacity: 0.5;
}

.card-stamp {
  position: absolute;
  top: var(--space-4);
  right: var(--space-4);
}

.name {
  margin-top: var(--space-3);
}

.meta {
  margin-top: var(--space-2);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.meta-tip {
  margin-top: var(--space-2);
}

.postcard-box {
  width: 100%;
  margin-top: var(--space-4);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-bg-deep);
  box-sizing: border-box;
}

.pc-line {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-title);
}

.pc-story {
  margin-top: var(--space-2);
  font-size: var(--font-md);
  color: var(--color-text);
  line-height: 1.7;
}

.cta {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.cta-copy {
  text-align: center;
  color: var(--color-text-2);
  font-size: var(--font-md);
}
