<wxs module="fmt">
var KM = getRegExp('([0-9]+(\\.[0-9]+)?)');
function km(s) {
  if (!s) return '';
  var m = KM.exec(s);
  return m ? m[1] : '';
}
// 文案里的 emoji 已在 constants 里去掉，这里原样返回
function clean(s) {
  return s || '';
}
module.exports = { km: km, clean: clean };
</wxs>

<view class="room {{ready ? (hasDisplay ? 'room-has' : 'room-empty') : ''}} {{decorMode ? 'room-decor' : ''}} {{currentBgId === 'night_lamp' ? 'room-night' : ''}}">
  <view class="nav-bar" style="padding-top: {{statusBar}}px; height: {{navBarHeight}}px;">
    <view class="nav-inner" style="height: {{navHeight}}px;">
      <text class="nav-title" bindlongpress="onToggleDebugUi">{{decorMode ? '摆一摆家具' : '我的小屋'}}</text>
    </view>
  </view>
  <view
    wx:if="{{showDebugUi}}"
    class="debug-btn"
    style="top: {{debugTop}}px;"
    hover-class="tap-press"
    bindtap="onToggleDebug"
  >{{debugLabel}}</view>

  <view class="room-body" style="padding-top: {{navPad}}px;">
    <!-- 顶部：谁在家 + 工具栏（不再浮在场景上，避免压住状态文字） -->
    <view wx:if="{{ready}}" class="head">
      <view class="head-main">
        <block wx:if="{{hasDisplay}}">
          <view class="head-name ellipsis">{{displayBreed}}</view>
          <view class="head-meta">
            <text class="seal seal-mint">在小屋</text>
            <text wx:if="{{intimacyText}}" class="tag tag-blush">{{intimacyText}}</text>
          </view>
        </block>
        <block wx:elif="{{catAway}}">
          <view class="head-name ellipsis">小屋空着</view>
          <view class="head-meta"><text class="tiny">等它散步回来</text></view>
        </block>
        <block wx:else>
          <view class="head-name ellipsis">我的小屋</view>
          <view class="head-meta"><text class="tiny">还没有猫住进来</text></view>
        </block>
      </view>
      <view class="tools">
        <view class="tool" hover-class="tap-press" bindtap="onVisitLog" aria-role="button" aria-label="猫猫出门记录">
          <view class="tool-ico"><image class="tool-img" src="/assets/art/room-outing.svg" mode="aspectFit" /></view>
          <text class="tool-label">出门</text>
        </view>
        <view
          wx:if="{{hasDisplay}}"
          class="tool {{decorMode ? 'tool-on' : ''}}"
          hover-class="tap-press"
          bindtap="onToggleDecor"
          aria-role="button"
          aria-label="摆家具"
        >
          <view class="tool-ico"><image class="tool-img" src="/assets/art/room-decor.svg" mode="aspectFit" /></view>
          <text class="tool-label">家具</text>
        </view>
        <view class="tool {{roomStyle === 'cartoon' ? 'tool-on' : ''}}" hover-class="tap-press" bindtap="onToggleRoomStyle" aria-role="button" aria-label="切换卡通或真猫">
          <view class="tool-ico"><image class="tool-img" src="/assets/art/cat-sit.svg" mode="aspectFit" /></view>
          <text class="tool-label">{{roomStyle === 'cartoon' ? '卡通' : '真猫'}}</text>
        </view>
        <view class="tool" hover-class="tap-press" bindtap="onChangeBg" aria-role="button" aria-label="换背景">
          <view class="tool-ico"><image class="tool-img" src="/assets/art/room-bg.svg" mode="aspectFit" /></view>
          <text class="tool-label">背景</text>
        </view>
        <view
          wx:if="{{showDebugUi && debugFast}}"
          class="tool tool-debug"
          hover-class="tap-press"
          bindtap="onDebugAdvance"
        >
          <view class="tool-ico"><text class="tool-debug-txt">推进</text></view>
          <text class="tool-label">调试</text>
        </view>
      </view>
    </view>

    <!-- 无展示猫（且没人外出） -->
    <block wx:if="{{ready && !hasDisplay && !catAway}}">
      <view class="empty-wrap">
        <view class="empty paper anim-rise">
          <image class="empty-illus" src="/assets/art/empty-room.svg" mode="aspectFit" />
          <view class="empty-title">还没有展示的猫</view>
          <view class="empty-sub">去图鉴里选一只，请它住进小屋吧</view>
          <button class="btn-primary empty-btn" bindtap="onGoAlbum">去图鉴选一只</button>
        </view>
      </view>
    </block>

    <!-- 有展示 / 出门中 -->
    <block wx:elif="{{ready}}">
      <!-- 外出标识：带头像，一眼能看出是谁出门了 -->
      <view wx:if="{{catAway}}" class="away paper anim-rise" hover-class="tap-press" catchtap="onAwayTap">
        <view class="away-avatar">
          <image
            wx:if="{{awayCatImage}}"
            class="away-img sticker"
            src="{{awayCatImage}}"
            mode="aspectFit"
          />
          <image wx:else class="away-img away-ghost" src="/assets/art/cat-shadow.svg" mode="aspectFit" />
        </view>
        <view class="away-body">
          <view class="away-row">
            <text class="away-name ellipsis">{{awayCatName}}</text>
            <text class="seal seal-sky">出门中</text>
          </view>
          <text class="away-sub">{{outHint}}</text>
        </view>
      </view>

      <view class="stage">
        <view class="scene scene-{{currentBgId}}" bindtap="onSceneTap">
          <!-- 墙 / 护墙板 / 踢脚线 / 地板：颜色来自 constants/backgrounds.js -->
          <block wx:for="{{backgrounds}}" wx:key="id">
            <block wx:if="{{item.id === currentBgId}}">
              <view class="scene-wall" style="background-color: {{item.colors[0]}};"></view>
              <view class="scene-wainscot" style="background-color: {{item.colors[1] || item.colors[0]}};"></view>
              <view class="scene-floor" style="background-color: {{item.colors[2] || item.colors[1]}};"></view>
            </block>
          </block>
          <view class="scene-skirting"></view>
          <view class="scene-rug"></view>

          <!-- 墙上的相框：记忆角 -->
          <view class="wall-frame" hover-class="tap-press" catchtap="onFrame">
            <image class="wall-frame-img" src="/assets/art/room-frame.svg" mode="aspectFit" />
            <view wx:if="{{memoryCount > 0}}" class="wall-frame-dot">{{memoryCount}}</view>
          </view>

          <block wx:for="{{furniture}}" wx:key="id">
            <view
              wx:if="{{item.placed || decorMode}}"
              class="furn furn-{{item.kind}} {{decorMode ? 'furn-edit' : ''}} {{!item.placed && decorMode ? 'furn-ghost' : ''}} {{dragId === item.id ? 'furn-drag' : ''}}"
              style="left: {{item.x}}%; top: {{item.y}}%; width: {{item.w}}%; height: {{item.h}}%; z-index: {{item.z}};"
              data-id="{{item.id}}"
              catchtouchstart="onFurnStart"
              catchtouchmove="onFurnMove"
              catchtouchend="onFurnEnd"
              catchtap="onFurnTap"
            >
              <image class="furn-body" src="/assets/art/furn-{{item.kind}}.svg" mode="aspectFit" />
            </view>
          </block>

          <!-- 出门中：空猫窝上留两枚爪印 + 小印章 -->
          <block wx:if="{{catAway && !decorMode}}">
            <block wx:for="{{furniture}}" wx:key="id">
              <view
                wx:if="{{item.kind === 'cushion' && item.placed}}"
                class="away-mark"
                style="left: {{item.x}}%; top: {{item.y}}%; z-index: {{item.z + 1}};"
              >
                <image class="away-paw ap1" src="/assets/art/room-paw.svg" mode="aspectFit" />
                <image class="away-paw ap2" src="/assets/art/room-paw.svg" mode="aspectFit" />
                <text class="seal seal-sky away-seal">出门中</text>
              </view>
            </block>
          </block>

          <view
            wx:if="{{hasDisplay}}"
            class="cat-slot cat-main {{showRing && careCardId === displayCardId ? 'cat-active' : ''}} {{catMoving ? 'cat-moving' : ''}} {{catFacingLeft ? 'cat-face-left' : ''}}"
            style="left: {{catX}}%; top: {{catY}}%; transition-duration: {{catMoveMs}}ms;"
            catchtap="onPet"
          >
            <view class="pet-flip">
              <image
                class="pet-img pet-breathe sticker"
                src="{{displayImage}}"
                mode="aspectFit"
                binderror="onPetImgError"
              />
            </view>
            <view wx:if="{{unreadBadge}}" class="report-dot" hover-class="tap-press" catchtap="onOpenReport">
              <image class="report-dot-img" src="/assets/art/room-letter.svg" mode="aspectFit" />
            </view>
            <view class="cat-tag {{showRing ? 'cat-tag-show' : ''}}">
              <text class="cat-tag-name">{{displayBreed}}</text>
              <text wx:if="{{intimacyText}}" class="cat-tag-bond">{{intimacyText}}</text>
            </view>
          </view>

          <!-- 同住：在家的另外几只 -->
          <block wx:if="{{hasDisplay}}">
            <view
              wx:for="{{roomMates}}"
              wx:key="id"
              class="cat-slot cat-mate {{item.facingLeft ? 'cat-face-left' : ''}} {{item.moving ? 'cat-moving' : ''}} {{item.preview ? 'cat-mate-preview' : ''}} {{showRing && careCardId === item.id ? 'cat-active' : ''}}"
              style="left: {{item.x}}%; top: {{item.y}}%; transition-duration: {{item.moveMs}}ms;"
              data-id="{{item.id}}"
              data-preview="{{item.preview}}"
              catchtap="onMateTap"
            >
              <view class="pet-flip">
                <image class="pet-img pet-breathe sticker" src="{{item.image}}" mode="aspectFit" />
              </view>
              <view class="cat-tag cat-tag-show">
                <text class="cat-tag-name">{{item.name}}</text>
              </view>
            </view>
          </block>

          <!-- 来访的猫：贴纸 + 便签「来自 X」 -->
          <view
            wx:if="{{visitor}}"
            class="visitor {{showVisitorMenu ? 'visitor-active' : ''}}"
            catchtap="onVisitorTap"
          >
            <view class="note visitor-note">来自 {{visitor.distanceLabel}}</view>
            <image
              wx:if="{{visitor.image}}"
              class="visitor-img sticker tilt-r"
              src="{{visitor.image}}"
              mode="aspectFit"
            />
            <image wx:else class="visitor-img visitor-ghost" src="/assets/art/cat-shadow.svg" mode="aspectFit" />
            <text class="seal {{visitor.fromReleased ? 'seal-blush' : 'seal-sky'}} visitor-seal">{{visitor.fromReleased ? '流浪来访' : '来串门'}}</text>
          </view>

          <!-- 来过又走了：地板上一串爪印 + 墙上一张小便签 -->
          <block wx:elif="{{leftTrace}}">
            <view class="trace-paws">
              <image class="trace-paw tp1" src="/assets/art/room-paw.svg" mode="aspectFit" />
              <image class="trace-paw tp2" src="/assets/art/room-paw.svg" mode="aspectFit" />
              <image class="trace-paw tp3" src="/assets/art/room-paw.svg" mode="aspectFit" />
              <image class="trace-paw tp4" src="/assets/art/room-paw.svg" mode="aspectFit" />
              <image class="trace-paw tp5" src="/assets/art/room-paw.svg" mode="aspectFit" />
            </view>
            <view class="note trace-note" hover-class="tap-press" catchtap="onLeftTrace">
              <view class="trace-text">{{leftPawText}}</view>
              <view class="trace-more">点开看看</view>
            </view>
          </block>
        </view>
      </view>

      <!-- 摆家具：家具托盘 -->
      <view wx:if="{{hasDisplay && decorMode}}" class="tray paper anim-rise">
        <view class="tray-head">
          <text class="tray-title">点一下摆上，拖一拖换位置</text>
          <button class="btn-primary btn-sm tray-done" bindtap="onToggleDecor">{{decorDone}}</button>
        </view>
        <view class="furn-tiles">
          <view
            wx:for="{{furniture}}"
            wx:key="id"
            class="furn-tile {{item.placed ? 'furn-tile-on' : ''}}"
            hover-class="tap-press"
            data-id="{{item.id}}"
            catchtap="onFurnTap"
          >
            <image class="furn-tile-img" src="/assets/art/furn-{{item.kind}}.svg" mode="aspectFit" />
            <text class="furn-tile-name">{{item.name}}</text>
            <text class="furn-tile-state">{{item.placed ? '已摆上' : '点我摆上'}}</text>
          </view>
        </view>
      </view>

      <!-- 底部面板一次只讲一件事：未读明信片 > 来访猫 > 日常照顾。点猫或点「照顾」切回照顾面板 -->
      <view wx:elif="{{unreadBadge && !careFocus && !showRing}}" class="tray paper focus anim-rise">
        <view class="focus-head">
          <image class="focus-ico" src="/assets/art/room-letter.svg" mode="aspectFit" />
          <view class="focus-text">
            <view class="focus-title">它回来了，带回一张明信片</view>
            <view class="focus-sub">看看它这趟去了哪儿</view>
          </view>
        </view>
        <button class="btn-primary btn-block focus-main" bindtap="onOpenReport">看看明信片</button>
        <view wx:if="{{hasDisplay}}" class="focus-switch" hover-class="tap-press" bindtap="onFocusCare">照顾小猫 ›</view>
      </view>

      <view wx:elif="{{visitor && !careFocus && !showRing}}" class="tray paper focus anim-rise">
        <view class="focus-head">
          <image
            wx:if="{{visitor.image}}"
            class="focus-cat sticker"
            src="{{visitor.image}}"
            mode="aspectFit"
          />
          <image wx:else class="focus-cat visitor-ghost" src="/assets/art/cat-shadow.svg" mode="aspectFit" />
          <view class="focus-text">
            <view class="focus-row">
              <text class="focus-title">{{visitor.fromReleased ? '有只流浪猫来了' : '有猫来串门了'}}</text>
              <text class="seal {{visitor.fromReleased ? 'seal-blush' : 'seal-sky'}}">{{visitor.fromReleased ? '流浪来访' : '来串门'}}</text>
            </view>
            <view class="focus-sub">来自 {{visitor.distanceLabel}}</view>
          </view>
        </view>
        <view wx:if="{{visitor.behaviorText}}" class="vs-behavior hand focus-behavior">{{visitor.behaviorText}}</view>
        <view class="vs-ops focus-ops">
          <button
            class="btn-secondary vs-btn {{visitor.petByHost ? 'vs-done' : ''}}"
            disabled="{{visitor.petByHost}}"
            data-action="pet"
            catchtap="onInteract"
          >{{visitor.petByHost ? btnPetted : btnPet}}</button>
          <button
            class="btn-secondary vs-btn {{visitor.fedByHost ? 'vs-done' : ''}}"
            disabled="{{visitor.fedByHost}}"
            data-action="feed"
            catchtap="onInteract"
          >{{visitor.fedByHost ? btnFedDone : btnFed}}</button>
        </view>
        <button wx:if="{{visitor.canAdopt}}" class="btn-primary btn-block vs-adopt" catchtap="onAdoptVisitor">收下它的卡片</button>
        <view wx:if="{{hasDisplay}}" class="focus-switch" hover-class="tap-press" bindtap="onFocusCare">照顾小猫 ›</view>
      </view>

      <!-- 照顾：状态小条 + 圆形动作按钮 -->
      <view wx:elif="{{hasDisplay}}" class="tray paper">
        <view
          wx:if="{{(unreadBadge || visitor) && !showRing}}"
          class="focus-back"
          hover-class="tap-press"
          bindtap="onFocusEvent"
        >‹ {{unreadBadge ? '有一张新明信片' : '有猫在串门'}}</view>
        <!-- 只看一个亲密度：真实再遇见涨得多，小屋里摸摸喂喂涨一点 -->
        <view class="bond-line">
          <image class="bond-ico" src="/assets/art/room-mood.svg" mode="aspectFit" />
          <text class="bond-k">亲密度</text>
          <view class="need-track bond-track">
            <view class="need-fill need-fill-mood" style="width: {{intimacyValue}}%;"></view>
          </view>
          <text class="bond-v num">{{intimacyValue}}</text>
        </view>
        <view wx:if="{{roomEvent && !showRing}}" class="room-event hand">{{roomEvent}}</view>

        <view wx:if="{{showRing}}" class="acts">
          <view
            wx:for="{{ringActions}}"
            wx:key="id"
            class="act anim-pop delay-{{index + 1}}"
            hover-class="act-press"
            data-action="{{item.id}}"
            catchtap="onCareAction"
          >
            <view class="act-btn act-{{item.id}}">
              <image class="act-img" src="/assets/art/room-{{item.id}}.svg" mode="aspectFit" />
            </view>
            <text class="act-label">{{item.label}}</text>
          </view>
          <view class="act anim-pop delay-4" hover-class="act-press" catchtap="onOpenProfile">
            <view class="act-btn act-profile">
              <image class="act-img" src="/assets/art/room-profile.svg" mode="aspectFit" />
            </view>
            <text class="act-label">档案</text>
          </view>
        </view>
        <view wx:else class="acts-hint">
          <image class="acts-hint-paw" src="/assets/art/room-paw.svg" mode="aspectFit" />
          <text>{{(roomMateHint && !catAway) ? roomMateHint : '点一点小猫，摸摸它、喂喂它'}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 换背景 -->
  <view wx:if="{{showBgPanel}}" class="mask mask-bottom" bindtap="closeBg">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-grip"></view>
      <view class="sheet-title">选择背景</view>
      <view class="sheet-sub">多出门遇见猫、再遇见熟面孔，就能解锁新的小屋</view>
      <view class="bg-grid">
        <view
          wx:for="{{backgrounds}}"
          wx:key="id"
          class="bg-tile {{item.unlocked ? '' : 'bg-locked'}} {{item.id === currentBgId ? 'bg-on' : ''}}"
          hover-class="tap-press"
          data-id="{{item.id}}"
          data-unlocked="{{item.unlocked}}"
          data-need="{{item.need}}"
          bindtap="onPickBg"
        >
          <view class="bg-swatch">
            <view class="bg-sw-wall" style="background-color: {{item.colors[0]}};"></view>
            <view class="bg-sw-wain" style="background-color: {{item.colors[1] || item.colors[0]}};"></view>
            <view class="bg-sw-floor" style="background-color: {{item.colors[2] || item.colors[1]}};"></view>
            <view wx:if="{{!item.unlocked}}" class="bg-lock">
              <image class="bg-lock-img" src="/assets/art/room-lock.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="bg-name">{{item.name}}</view>
          <view wx:if="{{item.id === currentBgId}}" class="chip chip-on bg-chip">使用中</view>
          <view wx:elif="{{item.unlocked}}" class="chip bg-chip">已解锁</view>
          <view wx:else class="bg-cond">{{item.lockText}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 访客互动 -->
  <view wx:if="{{showVisitorMenu && visitor}}" class="mask mask-bottom" bindtap="onCloseVisitorMenu">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-grip"></view>
      <view class="vs-head">
        <view class="vs-pic">
          <image
            wx:if="{{visitor.image}}"
            class="vs-img sticker tilt-l"
            src="{{visitor.image}}"
            mode="aspectFit"
          />
          <image wx:else class="vs-img visitor-ghost" src="/assets/art/cat-shadow.svg" mode="aspectFit" />
        </view>
        <view class="vs-meta">
          <view class="sheet-title vs-title">{{visitor.fromReleased ? '流浪来访' : '来串门的猫'}}</view>
          <view class="note vs-note">来自 {{visitor.distanceLabel}}</view>
        </view>
      </view>
      <view wx:if="{{visitor.behaviorText}}" class="vs-behavior hand">{{visitor.behaviorText}}</view>
      <view class="vs-ops">
        <button
          class="btn-secondary vs-btn {{visitor.petByHost ? 'vs-done' : ''}}"
          disabled="{{visitor.petByHost}}"
          data-action="pet"
          catchtap="onInteract"
        >{{visitor.petByHost ? btnPetted : btnPet}}</button>
        <button
          class="btn-secondary vs-btn {{visitor.fedByHost ? 'vs-done' : ''}}"
          disabled="{{visitor.fedByHost}}"
          data-action="feed"
          catchtap="onInteract"
        >{{visitor.fedByHost ? btnFedDone : btnFed}}</button>
      </view>
      <button
        wx:if="{{visitor.canAdopt}}"
        class="btn-primary btn-block vs-adopt"
        catchtap="onAdoptVisitor"
      >收下它的卡片</button>
    </view>
  </view>

  <!-- 出门报告：明信片 -->
  <view wx:if="{{showReport}}" class="mask" catchtouchmove="noop">
    <view class="postcard card anim-pop">
      <view class="stamp card-stamp anim-stamp">
        <text class="stamp-k">出门</text>
        <text class="stamp-v">{{fmt.km(report.distanceLine) || '远方'}}</text>
        <text wx:if="{{fmt.km(report.distanceLine)}}" class="stamp-k">千米</text>
      </view>
      <view class="card-title">{{fmt.clean(report.title)}}</view>
      <view class="card-line">{{report.distanceLine}}</view>
      <outing-postcard postcard="{{report.postcard}}" />
      <button class="btn-primary btn-block card-btn" bindtap="onDismissReport">收下明信片</button>
      <button class="btn-ghost btn-block card-share" open-type="share" data-kind="postcard">分享给朋友</button>
    </view>
  </view>

  <!-- 来过的猫：明信片 -->
  <view wx:if="{{showLeftModal}}" class="mask" catchtouchmove="noop">
    <view class="postcard card anim-pop">
      <view class="stamp card-stamp anim-stamp">
        <text class="stamp-k">来访</text>
        <text class="stamp-v">{{fmt.km(leftBody) || '远方'}}</text>
        <text wx:if="{{fmt.km(leftBody)}}" class="stamp-k">千米</text>
      </view>
      <view class="card-title">{{fmt.clean(leftTitle)}}</view>
      <view class="card-line">{{leftBody}}</view>
      <view wx:if="{{leftBehavior}}" class="card-hand hand">{{leftBehavior}}</view>
      <button class="btn-primary btn-block card-btn" bindtap="onDismissLeft">{{btnOk}}</button>
    </view>
  </view>

  <cat-loading show="{{pageLoading}}" text="{{loadingText}}" />
</view>
