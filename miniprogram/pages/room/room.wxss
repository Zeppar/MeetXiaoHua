/* 小屋 · 猫咪相遇手帐
 * 公共类（.paper .note .seal .stamp .postcard .chip .tag .btn-* .mask .sheet-panel .empty .anim-*）见 app.wxss
 */

.room {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ================= 导航 ================= */

.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  box-sizing: border-box;
  pointer-events: none;
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 200rpx;
  box-sizing: border-box;
  pointer-events: auto;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-title);
  letter-spacing: 2rpx;
  line-height: 1;
}

.debug-btn {
  position: fixed;
  right: 200rpx;
  z-index: 99;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-note);
  border: 2rpx solid var(--color-line);
  font-size: var(--font-2xs);
  font-weight: 700;
  color: var(--color-text-2);
}

/* ================= 主体 ================= */

.room-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-left: var(--space-4);
  padding-right: var(--space-4);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 顶部：谁在家 + 工具 —— */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  padding: 4rpx 0 var(--space-2);
  flex-shrink: 0;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.head-name {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-title);
  line-height: 1.3;
}

.head-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: 8rpx;
  min-height: 40rpx;
}

.tools {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  flex-shrink: 0;
}

.tool {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-ico {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--color-surface);
  border: 3rpx solid var(--color-title);
  box-shadow: 0 4rpx 0 rgba(43, 38, 34, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tool-img {
  width: 44rpx;
  height: 44rpx;
}

.tool-label {
  margin-top: 8rpx;
  font-size: var(--font-2xs);
  font-weight: 700;
  color: var(--color-text-2);
  line-height: 1.2;
}

.tool-on .tool-ico {
  background: var(--color-primary-soft);
  border-color: var(--color-primary-deep);
  box-shadow: 0 4rpx 0 var(--color-primary-deep);
}

.tool-on .tool-label {
  color: var(--color-primary-ink);
}

.tool-debug .tool-ico {
  background: var(--color-note);
}

.tool-debug-txt {
  font-size: var(--font-2xs);
  font-weight: 800;
  color: var(--color-text-2);
}

/* —— 空小屋 —— */
.empty-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-wrap .empty {
  width: 100%;
  box-sizing: border-box;
  padding: var(--space-6) var(--space-4);
}

.empty-btn {
  margin-top: var(--space-4);
}

/* —— 出门中 —— */
.away {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  margin-bottom: var(--space-2);
  flex-shrink: 0;
}

.away-avatar {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-sky-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.away-img {
  width: 76rpx;
  height: 76rpx;
}

.away-ghost {
  opacity: 0.55;
}

.away-body {
  flex: 1;
  min-width: 0;
}

.away-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.away-name {
  max-width: 300rpx;
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--color-title);
}

.away-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-muted);
  line-height: 1.45;
}

/* ================= 场景 ================= */

.stage {
  flex: 1;
  min-height: 380rpx;
  position: relative;
}

.scene {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  border-radius: var(--radius-xl);
  border: 4rpx solid var(--color-title);
  background: var(--color-bg-deep);
  box-shadow: 0 8rpx 0 rgba(43, 38, 34, 0.12);
}

/* 墙：上半 */
.scene-wall {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 50%;
}

/* 护墙板：竖条细线 + 顶部腰线 */
.scene-wainscot {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 12%;
  border-top: 4rpx solid rgba(43, 38, 34, 0.55);
  background-image: repeating-linear-gradient(90deg, transparent 0, transparent 88rpx, rgba(43, 38, 34, 0.1) 88rpx, rgba(43, 38, 34, 0.1) 91rpx);
  box-sizing: border-box;
}

/* 踢脚线 */
.scene-skirting {
  position: absolute;
  left: 0;
  right: 0;
  top: 62%;
  height: 14rpx;
  margin-top: -7rpx;
  z-index: 1;
  background: var(--color-surface);
  border-top: 3rpx solid var(--color-title);
  border-bottom: 3rpx solid var(--color-title);
}

/* 地板：底色来自背景数据，叠一层木板缝 */
.scene-floor {
  position: absolute;
  left: 0;
  right: 0;
  top: 62%;
  bottom: 0;
  background-image:
    repeating-linear-gradient(180deg, transparent 0, transparent 54rpx, rgba(43, 38, 34, 0.12) 54rpx, rgba(43, 38, 34, 0.12) 57rpx),
    repeating-linear-gradient(90deg, transparent 0, transparent 150rpx, rgba(43, 38, 34, 0.07) 150rpx, rgba(43, 38, 34, 0.07) 153rpx);
}

/* 地毯：一块扁平椭圆 */
.scene-rug {
  position: absolute;
  left: 22%;
  right: 22%;
  top: 76%;
  height: 15%;
  border-radius: 50%;
  background: rgba(255, 253, 249, 0.42);
  border: 3rpx dashed rgba(43, 38, 34, 0.22);
  box-sizing: border-box;
}

/* —— 墙上的相框：记忆角 —— */
.wall-frame {
  position: absolute;
  right: 5%;
  top: 5%;
  width: 96rpx;
  height: 96rpx;
  z-index: 8;
}

.wall-frame-img {
  width: 100%;
  height: 100%;
}

.wall-frame-dot {
  position: absolute;
  right: -10rpx;
  top: 4rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: var(--color-blush);
  border: 3rpx solid var(--color-surface);
  color: var(--color-on-primary);
  font-size: var(--font-2xs);
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

/* —— 家具 —— */
.furn {
  position: absolute;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
  pointer-events: none;
}

.furn-body {
  width: 100%;
  height: 100%;
  display: block;
}

.room-decor .furn-edit {
  pointer-events: auto;
  border-radius: var(--radius-sm);
  border: 3rpx dashed rgba(43, 38, 34, 0.4);
}

.furn-ghost {
  opacity: 0.35;
}

.furn-drag {
  transform: translate(-50%, -50%) scale(1.06);
  filter: drop-shadow(0 12rpx 14rpx rgba(80, 50, 20, 0.25));
  z-index: 40 !important;
}

/* —— 出门中：空猫窝上的爪印 —— */
.away-mark {
  position: absolute;
  width: 170rpx;
  height: 90rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.away-paw {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  opacity: 0.3;
}

.ap1 {
  left: 44rpx;
  top: 34rpx;
  transform: rotate(-20deg);
}

.ap2 {
  left: 96rpx;
  top: 22rpx;
  transform: rotate(14deg);
}

.away-seal {
  position: absolute;
  left: 50%;
  top: -34rpx;
  margin-left: -50rpx;
  background: var(--color-surface);
}

/* —— 猫 —— */
.cat-slot {
  position: absolute;
  width: 36%;
  z-index: 12;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translate(-50%, -50%);
  transition-property: left, top;
  transition-timing-function: linear;
}

.cat-main {
  z-index: 14;
}

.cat-mate {
  z-index: 11;
  transform: translate(-50%, -50%) scale(0.86);
}

.cat-mate-preview {
  opacity: 0.88;
}

.pet-flip {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  transform: scaleX(1);
}

/* 落地影子 */
.pet-flip::after {
  content: '';
  position: absolute;
  left: 24%;
  right: 24%;
  bottom: 2rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(43, 38, 34, 0.16);
  z-index: 0;
}

.cat-face-left .pet-flip {
  transform: scaleX(-1);
}

.cat-moving .pet-flip {
  animation: cat-walk-r 0.52s ease-in-out infinite;
}

.cat-face-left.cat-moving .pet-flip {
  animation: cat-walk-l 0.52s ease-in-out infinite;
}

.pet-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 220rpx;
  transform-origin: 50% 85%;
}

.pet-breathe {
  animation: cat-breathe 2.8s ease-in-out infinite;
}

.cat-active .pet-breathe {
  animation: cat-bob 0.45s ease;
}

.cat-moving .pet-breathe {
  animation: none;
}

.cat-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  margin-top: 4rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  box-sizing: border-box;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.cat-tag-show {
  opacity: 1;
}

.cat-tag-name {
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--color-title);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cat-tag-bond {
  font-size: var(--font-2xs);
  font-weight: 700;
  color: var(--color-blush-ink);
  white-space: nowrap;
}

.cat-active .cat-tag {
  border-color: var(--color-primary);
}

/* 报告信封 */
.report-dot {
  position: absolute;
  right: 8%;
  top: -8rpx;
  z-index: 3;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-surface);
  border: 3rpx solid var(--color-title);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  animation: room-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both, room-wiggle 2.4s ease-in-out 0.4s infinite;
}

.report-dot-img {
  width: 40rpx;
  height: 40rpx;
}

/* —— 来访的猫 —— */
.visitor {
  position: absolute;
  right: 3%;
  bottom: 5%;
  width: 30%;
  z-index: 15;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.visitor-note {
  max-width: 250rpx;
  margin-bottom: 10rpx;
  padding: 10rpx 16rpx 14rpx;
  font-size: var(--font-2xs);
  line-height: 1.4;
  text-align: center;
  box-sizing: border-box;
}

.visitor-img {
  width: 100%;
  height: 180rpx;
}

.visitor-ghost {
  opacity: 0.6;
}

.visitor-active .visitor-img {
  transform: rotate(2deg) translateY(-8rpx);
}

.visitor-seal {
  margin-top: -6rpx;
  background: var(--color-surface);
}

/* —— 来过的猫：爪印 + 便签 —— */
.trace-paws {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 6;
  pointer-events: none;
}

.trace-paw {
  position: absolute;
  width: 38rpx;
  height: 38rpx;
  opacity: 0.22;
}

.tp1 { right: 5%; top: 88%; transform: rotate(-80deg); }
.tp2 { right: 15%; top: 82%; transform: rotate(-100deg); }
.tp3 { right: 25%; top: 88%; transform: rotate(-80deg); }
.tp4 { right: 35%; top: 82%; transform: rotate(-100deg); }
.tp5 { right: 45%; top: 88%; transform: rotate(-80deg); }

.trace-note {
  position: absolute;
  left: 41%;
  top: 6%;
  width: 34%;
  z-index: 20;
  padding: 14rpx 18rpx 20rpx;
  box-sizing: border-box;
}

.trace-text {
  font-size: var(--font-xs);
  line-height: 1.45;
}

.trace-more {
  margin-top: 6rpx;
  font-size: var(--font-2xs);
  opacity: 0.7;
}

/* ================= 底部托盘 ================= */

.tray {
  flex-shrink: 0;
  margin-top: var(--space-3);
  padding: var(--space-3);
}

/* 状态：图标 + 迷你条 */
.needs {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.need {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg-deep);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.need-low {
  border-color: var(--color-line);
  background: var(--color-surface);
}

.need-ico {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.need-label {
  font-size: var(--font-2xs);
  color: var(--color-text-2);
  flex-shrink: 0;
}

.need-track {
  flex: 1;
  min-width: 24rpx;
  height: 10rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  overflow: hidden;
}

.need-low .need-track {
  background: var(--color-bg-deep);
}

.need-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  transition: width 0.5s ease;
}

.need-fill-mood { background: var(--color-blush); }
.need-fill-clean { background: var(--color-sky); }
.need-fill-energy { background: var(--color-mint); }

.need-val {
  font-size: var(--font-2xs);
  color: var(--color-muted);
  flex-shrink: 0;
}

/* 动作：圆形按钮 */
.acts {
  display: flex;
  justify-content: space-between;
  margin-top: var(--space-3);
  height: 150rpx;
}

.act {
  width: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.act-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-title);
  box-shadow: 0 6rpx 0 rgba(43, 38, 34, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.act-press .act-btn {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(43, 38, 34, 0.9);
}

.act-pet { background: var(--color-primary-soft); }
.act-feed { background: var(--color-sky-soft); }
.act-play { background: var(--color-blush-soft); }
.act-sleep { background: var(--color-note); }
.act-profile { background: var(--color-mint-soft); }

.act-img {
  width: 56rpx;
  height: 56rpx;
}

.act-label {
  margin-top: 14rpx;
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--color-title);
  line-height: 1.2;
}

.acts-hint {
  height: 150rpx;
  margin-top: var(--space-3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--color-line);
  font-size: var(--font-sm);
  color: var(--color-muted);
  box-sizing: border-box;
  padding: 0 var(--space-3);
  text-align: center;
}

.acts-hint-paw {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.25;
  flex-shrink: 0;
}

/* 摆家具托盘 */
.tray-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.tray-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--color-text-2);
}

.tray-done {
  flex-shrink: 0;
}

.furn-tiles {
  display: flex;
  gap: 12rpx;
  margin-top: var(--space-2);
}

.furn-tile {
  flex: 1;
  min-width: 0;
  padding: 12rpx 4rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: var(--radius-md);
  background: var(--color-bg-deep);
  border: 2rpx dashed var(--color-line);
  box-sizing: border-box;
}

.furn-tile-on {
  background: var(--color-mint-soft);
  border: 2rpx solid var(--color-mint);
}

.furn-tile-img {
  width: 100%;
  height: 72rpx;
}

.furn-tile-name {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--color-title);
}

.furn-tile-state {
  font-size: var(--font-2xs);
  color: var(--color-muted);
}

.furn-tile-on .furn-tile-state {
  color: var(--color-mint-ink);
}

/* ================= 底部面板 ================= */

.sheet-title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-title);
}

.sheet-sub {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-muted);
}

/* —— 背景 —— */
.bg-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: var(--space-3);
}

.bg-tile {
  width: calc(50% - 10rpx);
  padding: 16rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  border: 3rpx solid var(--color-line);
  box-sizing: border-box;
}

.bg-on {
  border-color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

.bg-swatch {
  position: relative;
  height: 150rpx;
  border-radius: var(--radius-md);
  border: 3rpx solid var(--color-title);
  overflow: hidden;
  box-sizing: border-box;
}

.bg-sw-wall {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 52%;
}

.bg-sw-wain {
  position: absolute;
  left: 0;
  right: 0;
  top: 52%;
  height: 16%;
  border-top: 3rpx solid rgba(43, 38, 34, 0.55);
  box-sizing: border-box;
}

.bg-sw-floor {
  position: absolute;
  left: 0;
  right: 0;
  top: 68%;
  bottom: 0;
  border-top: 3rpx solid var(--color-title);
  background-image: repeating-linear-gradient(90deg, transparent 0, transparent 46rpx, rgba(43, 38, 34, 0.1) 46rpx, rgba(43, 38, 34, 0.1) 49rpx);
}

.bg-locked .bg-sw-wall,
.bg-locked .bg-sw-wain,
.bg-locked .bg-sw-floor {
  opacity: 0.45;
}

.bg-lock {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 64rpx;
  height: 64rpx;
  margin: -32rpx 0 0 -32rpx;
  border-radius: 50%;
  background: var(--color-surface);
  border: 3rpx solid var(--color-title);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.bg-lock-img {
  width: 38rpx;
  height: 38rpx;
}

.bg-name {
  margin-top: 14rpx;
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--color-title);
}

.bg-chip {
  margin-top: 8rpx;
  height: 44rpx;
  padding: 0 18rpx;
  font-size: var(--font-2xs);
}

.bg-cond {
  margin-top: 8rpx;
  font-size: var(--font-2xs);
  color: var(--color-muted);
  line-height: 1.5;
}

/* —— 访客 —— */
.vs-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.vs-pic {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.vs-img {
  width: 100%;
  height: 100%;
}

.vs-meta {
  flex: 1;
  min-width: 0;
}

.vs-note {
  display: inline-block;
  margin-top: var(--space-2);
  padding: 12rpx 20rpx 16rpx;
  font-size: var(--font-sm);
}

.vs-behavior {
  margin-top: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-bg-deep);
  font-size: var(--font-md);
  color: var(--color-text);
  line-height: 1.6;
}

.vs-ops {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.vs-ops .vs-btn {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 16rpx;
  font-size: var(--font-sm);
}

.vs-ops .vs-btn.vs-done {
  color: var(--color-muted) !important;
  background: var(--color-bg-deep) !important;
  border-color: var(--color-line) !important;
  box-shadow: none !important;
}

.vs-adopt {
  margin-top: var(--space-3);
}

/* ================= 明信片弹窗 ================= */

.card {
  width: 620rpx;
  padding: var(--space-6) var(--space-5) var(--space-5);
  box-sizing: border-box;
}

.card-stamp {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
}

.card-title {
  min-height: 60rpx;
  padding-right: 150rpx;
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--color-title);
  line-height: 1.3;
}

.card-line {
  margin-top: var(--space-2);
  padding-right: 130rpx;
  font-size: var(--font-sm);
  color: var(--color-text-2);
  line-height: 1.6;
}

.card-hand {
  margin-top: var(--space-4);
  padding: var(--space-2) 0;
  border-top: 2rpx dashed var(--color-line);
  border-bottom: 2rpx dashed var(--color-line);
  font-size: var(--font-lg);
  color: var(--color-title);
  line-height: 1.6;
}

.card-who {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: var(--space-3);
  font-size: var(--font-sm);
  color: var(--color-blush-ink);
}

.card-who-ico {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.45;
  flex-shrink: 0;
}

.card-btn {
  margin-top: var(--space-5);
}

/* ================= 动效 ================= */

@keyframes cat-breathe {
  0%, 100% { transform: scale(1, 1); }
  50% { transform: scale(1.035, 0.965); }
}

@keyframes cat-bob {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  40% { transform: translateY(-10rpx) scale(1.02, 0.98); }
}

@keyframes cat-walk-r {
  0%, 100% { transform: scaleX(1) translateY(0); }
  50% { transform: scaleX(1) translateY(-8rpx); }
}

@keyframes cat-walk-l {
  0%, 100% { transform: scaleX(-1) translateY(0); }
  50% { transform: scaleX(-1) translateY(-8rpx); }
}

@keyframes room-pop {
  0% { opacity: 0; transform: scale(0.6); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes room-wiggle {
  0%, 100% { transform: rotate(-6deg); }
  50% { transform: rotate(6deg); }
}
